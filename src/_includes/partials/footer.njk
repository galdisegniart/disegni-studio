<footer>
  {% set siteL = site | localize(locale) %}
  {% set prefix = locale | localePrefix %}
  {% set isEn = locale == "en" %}
  <div class="footer-contact">
    <h2>{{ "Talk to Me" if isEn else "דברו איתי" }}</h2>
    <form id="footer-contact-form" class="lead-form" novalidate>
      <label>
        <span>{{ "First Name *" if isEn else "שם פרטי *" }}</span>
        <input type="text" name="firstName" required>
      </label>
      <label>
        <span>{{ "Last Name" if isEn else "שם משפחה" }}</span>
        <input type="text" name="lastName">
      </label>
      <label>
        <span>{{ "Email *" if isEn else "דוא\"ל *" }}</span>
        <input type="email" name="email" required>
      </label>
      <label>
        <span>{{ "Phone *" if isEn else "טלפון *" }}</span>
        <input type="tel" name="phone" required>
      </label>
      <label class="lead-form-full">
        <span>{{ "Message" if isEn else "הודעה" }}</span>
        <textarea name="message" rows="3"></textarea>
      </label>
      <button type="submit" class="cta lead-submit">{{ "Send" if isEn else "שליחה" }}</button>
      <p class="lead-form-success js-footer-contact-success" role="status" hidden>{{ "The message is ready - WhatsApp will open so you can send it." if isEn else "ההודעה מוכנה - נפתח WhatsApp כדי לשלוח אותה." }}</p>
    </form>
  </div>
  <nav class="footer-links" aria-label="{{ 'Site links' if isEn else 'קישורים באתר' }}">
    {% for item in siteL.nav %}
    {% if item.visible != false %}
    <a href="{{ prefix }}{{ item.href }}">{{ item.label }}</a>
    {% if item.children %}
    {% for child in item.children %}
    {% if child.visible != false %}
    <a href="{{ prefix }}{{ child.href }}">{{ child.label }}</a>
    {% endif %}
    {% endfor %}
    {% endif %}
    {% endif %}
    {% endfor %}
  </nav>
  <div class="footer-meta">
    <span>{{ siteL.tagline }}</span>
  </div>
  <div class="footer-brand">
    <span>{{ siteL.brand }}</span>
    <a href="#top">{{ "Back to top ↑" if isEn else "חזרה למעלה ↑" }}</a>
  </div>
  <nav class="site-socials" aria-label="{{ (siteL.brand ~ ' on social media') if isEn else (siteL.brand ~ ' ברשתות החברתיות') }}">
    <a href="{{ site.socials[0].href }}" target="_blank" rel="noopener noreferrer" aria-label="{{ (siteL.brand ~ ' on Instagram') if isEn else ('אינסטגרם של ' ~ siteL.brand) }}">
      <svg viewBox="0 0 24 24" aria-hidden="true"><rect x="3" y="3" width="18" height="18" rx="5"></rect><circle cx="12" cy="12" r="4.2"></circle><circle cx="17.4" cy="6.7" r="1"></circle></svg>
    </a>
    <a href="{{ site.socials[1].href }}" target="_blank" rel="noopener noreferrer" aria-label="{{ (siteL.brand ~ ' on TikTok') if isEn else ('טיקטוק של ' ~ siteL.brand) }}">
      <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M14.2 3v11.1a4.7 4.7 0 1 1-4.1-4.65v3.05a1.8 1.8 0 1 0 1.2 1.7V3h2.9Zm0 0c.35 2.05 1.55 3.45 3.8 3.8v3.1c-1.55-.05-2.85-.5-3.8-1.25"></path></svg>
    </a>
    <a href="{{ site.socials[2].href }}" target="_blank" rel="noopener noreferrer" aria-label="{{ (siteL.brand ~ ' on Facebook') if isEn else ('פייסבוק של ' ~ siteL.brand) }}">
      <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M14 21v-8h2.8l.45-3H14V8.2c0-.9.3-1.5 1.65-1.5h1.75V4.05c-.3-.05-1.35-.15-2.55-.15-2.5 0-4.2 1.5-4.2 4.35V10H8v3h2.65v8H14Z"></path></svg>
    </a>
    <a href="{{ site.socials[3].href }}" target="_blank" rel="noopener noreferrer" aria-label="{{ (siteL.brand ~ ' on YouTube') if isEn else ('יוטיוב של ' ~ siteL.brand) }}">
      <svg viewBox="0 0 24 24" aria-hidden="true"><rect x="2.5" y="6" width="19" height="12" rx="4"></rect><path d="M10.8 9.5v5l4.4-2.5Z"></path></svg>
    </a>
  </nav>
  <div class="footer-legal">
    {% include "partials/legal-links.njk" %}
  </div>
</footer>
