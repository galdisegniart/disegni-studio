{% set isEn = locale == "en" %}
<div class="review-form-intro">
  <p class="hero-eyebrow">{{ "Attended a workshop?" if isEn else "הייתם בסדנה?" }}</p>
  <h2>{{ "Tell us how it went." if isEn else "ספרו איך היה לכם." }}</h2>
  <p>{{ "Your review will be sent to Gal for a quick check before it's published on the site." if isEn else "חוות הדעת תישלח לגל לבדיקה קצרה לפני שהיא מתפרסמת באתר." }}</p>
</div>
<form class="review-form" id="review-form" data-workshop="{{ w.cardTitle }}">
  <label>{{ "Full Name" if isEn else "שם מלא" }}<input type="text" name="reviewer" autocomplete="name" required></label>
  <div class="review-rating-field">
    <span>{{ "Your Rating" if isEn else "הדירוג שלכם" }}</span>
    <div class="review-rating-buttons" role="radiogroup" aria-label="{{ 'Choose a rating' if isEn else 'בחירת דירוג' }}">
      <button type="button" data-rating="1" aria-label="{{ 'One star' if isEn else 'כוכב אחד' }}" aria-pressed="false">★</button>
      <button type="button" data-rating="2" aria-label="{{ 'Two stars' if isEn else 'שני כוכבים' }}" aria-pressed="false">★</button>
      <button type="button" data-rating="3" aria-label="{{ 'Three stars' if isEn else 'שלושה כוכבים' }}" aria-pressed="false">★</button>
      <button type="button" data-rating="4" aria-label="{{ 'Four stars' if isEn else 'ארבעה כוכבים' }}" aria-pressed="false">★</button>
      <button type="button" data-rating="5" aria-label="{{ 'Five stars' if isEn else 'חמישה כוכבים' }}" aria-pressed="false">★</button>
    </div>
    <input type="hidden" name="rating" required>
  </div>
  <label>{{ "Your Review" if isEn else "חוות הדעת" }}<textarea name="review" rows="4" required></textarea></label>
  <button class="cta review-submit" type="submit">{{ "Submit Review" if isEn else "שליחת חוות הדעת" }} <span>←</span></button>
  <p class="review-form-status" aria-live="polite"></p>
</form>
