{% set isEn = locale == "en" %}
{% set cartPrefix = locale | localePrefix %}
<div class="cart-drawer-overlay js-cart-drawer-close" hidden></div>
<aside class="cart-drawer" id="cart-drawer" aria-label="{{ 'Shopping cart' if isEn else 'עגלת קניות' }}" aria-hidden="true">
  <div class="cart-drawer-header">
    <h2>{{ 'My Cart' if isEn else 'העגלה שלי' }} <span class="cart-drawer-count"></span></h2>
    <button class="cart-drawer-close js-cart-drawer-close" type="button" aria-label="{{ 'Close cart' if isEn else 'סגירת העגלה' }}">×</button>
  </div>
  <div class="cart-drawer-body">
    <p class="cart-drawer-empty" hidden>{{ 'Your cart is still empty.' if isEn else 'העגלה עדיין ריקה.' }}</p>
    <ul class="cart-drawer-items"></ul>
  </div>
  <div class="cart-drawer-footer" hidden>
    <div class="cart-drawer-summary-row">
      <span>{{ 'Subtotal' if isEn else 'סכום ביניים' }}</span>
      <strong class="cart-drawer-subtotal"></strong>
    </div>
    <div class="cart-drawer-summary-row cart-drawer-shipping-row">
      <span>{{ 'Shipping' if isEn else 'משלוח' }}</span>
      <strong class="cart-drawer-shipping"></strong>
    </div>
    <div class="cart-drawer-summary-row cart-drawer-total-row">
      <span>{{ 'Total' if isEn else 'סה״כ' }}</span>
      <strong class="cart-drawer-total"></strong>
    </div>
    <a class="cart-drawer-checkout" href="{{ cartPrefix }}/cart/">{{ 'Go to Cart & Checkout' if isEn else 'לעגלה ולתשלום' }} <span aria-hidden="true">←</span></a>
    <button class="cart-drawer-continue js-cart-drawer-close" type="button">{{ 'Continue Shopping' if isEn else 'המשך בקנייה' }}</button>
  </div>
</aside>
