<div class="cart-drawer-overlay js-cart-drawer-close" hidden></div>
<aside class="cart-drawer" id="cart-drawer" aria-label="עגלת קניות" aria-hidden="true">
  <div class="cart-drawer-header">
    <h2>העגלה שלי <span class="cart-drawer-count"></span></h2>
    <button class="cart-drawer-close js-cart-drawer-close" type="button" aria-label="סגירת העגלה">×</button>
  </div>
  <div class="cart-drawer-body">
    <p class="cart-drawer-empty" hidden>העגלה עדיין ריקה.</p>
    <ul class="cart-drawer-items"></ul>
  </div>
  <div class="cart-drawer-footer" hidden>
    <div class="cart-drawer-summary-row">
      <span>סכום ביניים</span>
      <strong class="cart-drawer-subtotal"></strong>
    </div>
    <div class="cart-drawer-summary-row cart-drawer-shipping-row">
      <span>משלוח</span>
      <strong class="cart-drawer-shipping"></strong>
    </div>
    <div class="cart-drawer-summary-row cart-drawer-total-row">
      <span>סה״כ</span>
      <strong class="cart-drawer-total"></strong>
    </div>
    <a class="cart-drawer-checkout" href="/cart/">לעגלה ולתשלום <span aria-hidden="true">←</span></a>
    <button class="cart-drawer-continue js-cart-drawer-close" type="button">המשך בקנייה</button>
  </div>
</aside>
