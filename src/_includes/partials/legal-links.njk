{% set isEn = locale == "en" %}
{% set prefix = locale | localePrefix %}
<p class="footer-legal-links"><a href="{{ prefix }}/terms/">{{ "Terms & Purchase Policy" if isEn else "תקנון ומדיניות רכישה" }}</a> · <a href="{{ prefix }}/returns/">{{ "Cancellations & Returns" if isEn else "מדיניות ביטולים והחזרים" }}</a> · <a href="{{ prefix }}/rights/">{{ "Copyright Policy" if isEn else "מדיניות זכויות יוצרים" }}</a> · <a href="{{ prefix }}/privacy/">{{ "Privacy Policy" if isEn else "מדיניות פרטיות" }}</a> · <a href="{{ prefix }}/accessibility/">{{ "Accessibility Statement" if isEn else "הצהרת נגישות" }}</a> · <a href="{{ prefix }}/contact/">{{ "Contact" if isEn else "יצירת קשר" }}</a></p>
<p class="footer-legal-business">{% if site.businessLegalName %}{{ site.businessLegalName }}{% if site.businessNumber %} · {{ site.businessStatus }} {{ site.businessNumber }}{% endif %} · {% endif %}{% if site.businessAddress %}{{ site.businessAddress }}, {{ site.businessCity }} · {% elif site.businessCity %}{{ site.businessCity }} · {% endif %}<a href="tel:{{ site.businessPhoneLink }}" dir="ltr">{{ site.businessPhone }}</a> · <a href="mailto:{{ site.supportEmail }}" dir="ltr">{{ site.supportEmail }}</a></p>
<p class="footer-legal-copy">© {{ currentYear }} {{ (site | localize(locale)).brand }}. {{ "All rights reserved." if isEn else "כל הזכויות שמורות." }}</p>
