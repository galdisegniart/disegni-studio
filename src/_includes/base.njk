<!DOCTYPE html>
<html lang="{{ locale or 'he' }}" dir="{{ 'ltr' if locale == 'en' else 'rtl' }}">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{{ title }}</title>
<meta name="description" content="{{ description }}">
{% if noindex %}<meta name="robots" content="noindex, nofollow">{% endif %}
<link rel="canonical" href="{{ site.siteUrl }}{{ page.url }}">
{% if locale %}
{% set enUrl = page.url if locale == "en" else (page.url | altLocaleUrl(locale)) %}
{% set heUrl = page.url if locale == "he" else (page.url | altLocaleUrl(locale)) %}
<link rel="alternate" hreflang="en" href="{{ site.siteUrl }}{{ enUrl }}">
<link rel="alternate" hreflang="he" href="{{ site.siteUrl }}{{ heUrl }}">
<link rel="alternate" hreflang="x-default" href="{{ site.siteUrl }}{{ enUrl }}">
{% endif %}
<link rel="icon" type="image/svg+xml" href="/favicon.svg">
<meta property="og:type" content="website">
<meta property="og:locale" content="{{ 'en_US' if locale == 'en' else 'he_IL' }}">
{% if locale %}<meta property="og:locale:alternate" content="{{ 'he_IL' if locale == 'en' else 'en_US' }}">{% endif %}
<meta property="og:site_name" content="{{ (site | localize(locale)).brand }}">
<meta property="og:title" content="{{ title }}">
<meta property="og:description" content="{{ description }}">
<meta property="og:url" content="{{ site.siteUrl }}{{ page.url }}">
<meta property="og:image" content="{{ site.siteUrl }}{{ ogImage or '/images/disegni-profile.webp' }}">
<meta name="twitter:card" content="summary_large_image">
{% include "partials/schema-org.njk" %}
{% if site.gaMeasurementId %}
<script async src="https://www.googletagmanager.com/gtag/js?id={{ site.gaMeasurementId }}"></script>
<script>
  window.dataLayer = window.dataLayer || [];
  function gtag(){dataLayer.push(arguments);}
  gtag('js', new Date());
  gtag('config', '{{ site.gaMeasurementId }}');
</script>
{% endif %}
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Assistant:wght@300;400;500;600&display=swap" rel="stylesheet">
<link rel="stylesheet" href="/css/style.css?v={{ buildTime }}">
<style>
:root {
  --scale-nav: {{ (site.typeScale.navPercent / 100) if site.typeScale.navPercent else 1 }};
  --scale-heading: {{ (site.typeScale.headingPercent / 100) if site.typeScale.headingPercent else 1 }};
  --scale-subheading: {{ (site.typeScale.subheadingPercent / 100) if site.typeScale.subheadingPercent else 1 }};
  --scale-legal: {{ (site.typeScale.legalPercent / 100) if site.typeScale.legalPercent else 1 }};
  --scale-quick-links: {{ (site.quickLinksButtonPercent / 100) if site.quickLinksButtonPercent else 1 }};
  --scale-category-card: {{ (site.categoryCardSizePercent / 100) if site.categoryCardSizePercent else 1 }};
}
</style>
</head>
<body id="top"{% if bodyClass %} class="{{ bodyClass }}"{% endif %} data-whatsapp="{{ site.whatsappNumber }}">

<a class="skip-link" href="#main-content">{{ "Skip to main content" if locale == "en" else "דילוג לתוכן הראשי" }}</a>

{% include "partials/site-header.njk" %}

{% include "partials/cart-drawer.njk" %}

<nav class="quick-links-rail" aria-label="{{ 'Quick links' if locale == 'en' else 'קישורים מהירים' }}">
  <button type="button" class="quick-links-toggle" aria-expanded="false" aria-controls="quick-links-menu" aria-label="{{ 'Quick links' if locale == 'en' else 'קישורים מהירים' }}">
    <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 5v14M5 12h14"></path></svg>
  </button>
  <div class="quick-links-menu" id="quick-links-menu">
    <a href="{{ site.contactHref }}" aria-label="{{ 'Contact us' if locale == 'en' else 'יצירת קשר' }}">
      <svg viewBox="0 0 24 24" aria-hidden="true"><rect x="3" y="5" width="18" height="14" rx="2"></rect><path d="m4 6.5 8 6 8-6"></path></svg>
    </a>
    <a href="{{ site.socials[1].href }}" target="_blank" rel="noopener noreferrer" aria-label="{{ ((site | localize(locale)).brand ~ ' on TikTok') if locale == 'en' else ('טיקטוק של ' ~ site.brand) }}">
      <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M14.2 3v11.1a4.7 4.7 0 1 1-4.1-4.65v3.05a1.8 1.8 0 1 0 1.2 1.7V3h2.9Zm0 0c.35 2.05 1.55 3.45 3.8 3.8v3.1c-1.55-.05-2.85-.5-3.8-1.25"></path></svg>
    </a>
    <a href="{{ site.socials[0].href }}" target="_blank" rel="noopener noreferrer" aria-label="{{ ((site | localize(locale)).brand ~ ' on Instagram') if locale == 'en' else ('אינסטגרם של ' ~ site.brand) }}">
      <svg viewBox="0 0 24 24" aria-hidden="true"><rect x="3" y="3" width="18" height="18" rx="5"></rect><circle cx="12" cy="12" r="4.2"></circle><circle cx="17.4" cy="6.7" r="1"></circle></svg>
    </a>
  </div>
</nav>

<main id="main-content">
{{ content | safe }}
</main>

{% include "partials/footer.njk" %}

{% for s in scripts %}
<script src="{{ s }}?v={{ buildTime }}"></script>
{% endfor %}
<script src="/js/cart.js?v={{ buildTime }}"></script>
<script src="/js/nav-toggle.js?v={{ buildTime }}"></script>
<script src="/js/locale-detect.js?v={{ buildTime }}"></script>
<script src="/js/header-search.js?v={{ buildTime }}"></script>
<script src="/js/quick-links-toggle.js?v={{ buildTime }}"></script>
<script src="/js/footer-contact.js?v={{ buildTime }}"></script>
</body>
</html>
