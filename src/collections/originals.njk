---
pagination:
  data: locales
  size: 1
  alias: locale
  addAllPagesToCollections: true
layout: base.njk
activeCategory: "originals"
permalink: "{{ locale | localePrefix }}/collections/originals/index.html"
scripts:
  - /js/mark-list.js
eleventyComputed:
  title: "{{ (pages.originals | localize(locale)).title }}"
  description: "{{ (pages.originals | localize(locale)).metaDescription }}"
  activeNav: "{{ 'Available Originals' if locale == 'en' else 'מקוריות זמינות' }}"
---
{% include "partials/category-strip.njk" %}
{% set p = pages.originals | localize(locale) %}
{% set crumbs = [
  { label: "Home" if locale == "en" else "בית", href: (locale | localePrefix) + "/" },
  { label: p.heading }
] %}
{% include "partials/breadcrumbs.njk" %}
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "ItemList",
  "itemListElement": [{% for raw in artworks %}{% set artwork = raw | localize(locale) %}{
    "@type": "ListItem",
    "position": {{ loop.index }},
    "url": "{{ site.siteUrl }}{{ locale | localePrefix }}/products/{{ artwork.slug }}/",
    "name": {{ artwork.name | dump | safe }},
    "image": "{{ site.siteUrl }}{{ artwork.thumb }}"
  }{% if not loop.last %},{% endif %}{% endfor %}]
}
</script>
<section class="gallery-intro-minimal">
  <div class="shop-intro-layout">
    <h1>{{ p.heading }}</h1>
    <div class="shop-intro-copy">
      <p>{{ p.heroText }}</p>
    </div>
  </div>
</section>

<section class="artwork-catalog gallery-catalog-compact section">
  <div class="artwork-grid">
    {% for raw in artworks %}
    {% set artwork = raw | localize(locale) %}
    <article class="artwork-card{% if not artwork.originalAvailable %} artwork-card-sold-out{% endif %}" id="{{ artwork.slug }}" data-category="{{ artwork.category }}">
      <a class="artwork-tile" href="{{ locale | localePrefix }}/products/{{ artwork.slug }}/" aria-label="{{ ('View artwork ' ~ artwork.name) if locale == 'en' else ('כניסה ליצירה ' ~ artwork.name) }}">
        <span class="artwork-tile-image">
          <img src="{{ artwork.thumb }}" alt="{{ artwork.alt }}" loading="lazy">
          {% if not artwork.originalAvailable %}
          <span class="sold-out-badge">{{ "Sold" if locale == "en" else "נמכר" }}</span>
          {% endif %}
        </span>
        <span class="artwork-tile-caption">
          <strong lang="en">{{ artwork.name }}</strong>
          {% if artwork.originalAvailable %}
          <small>{{ artwork.originalPrice | numberFormat }} ₪</small>
          {% endif %}
        </span>
      </a>
    </article>
    {% endfor %}
  </div>
</section>
