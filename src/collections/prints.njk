---
pagination:
  data: locales
  size: 1
  alias: locale
  addAllPagesToCollections: true
layout: base.njk
activeCategory: "prints"
permalink: "{{ locale | localePrefix }}/collections/prints/index.html"
scripts:
  - /js/catalog-filter.js
  - /js/mark-list.js
eleventyComputed:
  title: "{{ (pages.prints | localize(locale)).title }}"
  description: "{{ (pages.prints | localize(locale)).metaDescription }}"
  activeNav: "{{ 'Prints' if locale == 'en' else 'הדפסים' }}"
---
{% include "partials/category-strip.njk" %}
{% set p = pages.prints | localize(locale) %}
{% set pricing = pages.pricing %}
{% set shipping = pages.shipping %}
{% set crumbs = [
  { label: "Home" if locale == "en" else "בית", href: (locale | localePrefix) + "/" },
  { label: p.heading }
] %}
{% include "partials/breadcrumbs.njk" %}
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "ItemList",
  "itemListElement": [{% for raw in artworks %}{% set artwork = raw | localize(locale) %}{
    "@type": "ListItem",
    "position": {{ loop.index }},
    "url": "{{ site.siteUrl }}{{ locale | localePrefix }}/products/{{ artwork.slug }}/",
    "name": {{ artwork.name | dump | safe }},
    "image": "{{ site.siteUrl }}{{ artwork.thumb }}"
  }{% if not loop.last %},{% endif %}{% endfor %}]
}
</script>
<section class="gallery-intro-minimal">
  <div class="shop-intro-layout">
    <h1>{{ p.heading }}</h1>
    <div class="shop-intro-copy">
      <p>{{ p.heroText }}</p>
      <a class="cta cta-outline shop-originals-link" href="/collections/originals/">{{ p.originalsLinkLabel }} <span class="dir-arrow" aria-hidden="true">←</span></a>
    </div>
  </div>
</section>

<section class="artwork-catalog gallery-catalog-compact section">
  <div class="catalog-toolbar">
    <h2>{{ p.catalogHeading }}</h2>
    <div class="catalog-filters">
      <button class="catalog-filter active" type="button" data-filter="all" aria-pressed="true">{{ p.filterAllLabel }}</button>
      {% for filter in p.filters %}
      <button class="catalog-filter" type="button" data-filter="{{ filter.value }}" aria-pressed="false">{{ filter.label }}</button>
      {% endfor %}
    </div>
  </div>
  <div class="artwork-grid">
    {% for raw in artworks %}
    {% set artwork = raw | localize(locale) %}
    {% set extraMaterials = artwork.extraMaterials or [] %}
    {% set printfulOptions = printfulCatalog | printfulOptions(artwork, pricing, shipping, locale) %}
    {% if printfulOptions and printfulOptions.length %}
    {% set range = printfulOptions | optionPriceRange %}
    {% else %}
    {% set range = pricing.materials | priceRange(extraMaterials) %}
    {% endif %}
    <article class="artwork-card" id="{{ artwork.slug }}" data-category="{{ artwork.category }}">
      <a class="artwork-tile" href="{{ locale | localePrefix }}/products/{{ artwork.slug }}/" aria-label="{{ ('View artwork ' ~ artwork.name) if locale == 'en' else ('כניסה ליצירה ' ~ artwork.name) }}">
        <span class="artwork-tile-image"><img src="{{ artwork.thumb }}" alt="{{ artwork.alt }}" loading="lazy"></span>
        <span class="artwork-tile-caption">
          <strong lang="en">{{ artwork.name }}</strong>
          <small>{{ artwork.galleryMedium }}</small>
          {% if range.low %}<span class="artwork-tile-price">{{ "From " if locale == "en" else "החל מ- " }}<span>{{ range.low }} ₪</span></span>{% endif %}
        </span>
      </a>
    </article>
    {% endfor %}
  </div>
</section>
