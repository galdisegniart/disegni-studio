---
pagination:
  data: locales
  size: 1
  alias: locale
  addAllPagesToCollections: true
layout: base.njk
activeCategory: "apparel"
permalink: "{{ locale | localePrefix }}/collections/apparel/index.html"
scripts:
  - /js/catalog-filter.js
  - /js/mark-list.js
eleventyComputed:
  title: "{{ (pages.apparel | localize(locale)).title }}"
  description: "{{ (pages.apparel | localize(locale)).metaDescription }}"
  activeNav: "{{ 'Shop' if locale == 'en' else 'חנות' }}"
---
{% include "partials/category-strip.njk" %}
{% set p = pages.apparel | localize(locale) %}
{% set clothingItems = apparelItems | withoutCategory("stickers") %}
{% set crumbs = [
  { label: "Home" if locale == "en" else "בית", href: (locale | localePrefix) + "/" },
  { label: p.heading }
] %}
{% include "partials/breadcrumbs.njk" %}
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "ItemList",
  "itemListElement": [{% for raw in clothingItems %}{% set item = raw | localize(locale) %}{
    "@type": "ListItem",
    "position": {{ loop.index }},
    "url": "{{ site.siteUrl }}{{ locale | localePrefix }}/shop/{{ item.slug }}/",
    "name": {{ item.name | dump | safe }},
    "image": "{{ site.siteUrl }}{{ item.image }}"
  }{% if not loop.last %},{% endif %}{% endfor %}]
}
</script>
<section class="gallery-intro-minimal">
  <div class="shop-intro-layout">
    <h1>{{ p.heading }}</h1>
    <div class="shop-intro-copy">
      <p>{{ p.heroText }}</p>
    </div>
  </div>
</section>

<section class="artwork-catalog gallery-catalog-compact section">
  <div class="catalog-toolbar">
    <div class="catalog-filters">
      <button class="catalog-filter active" type="button" data-filter="all" aria-pressed="true">{{ p.filterAllLabel }}</button>
      {% for filter in p.filters %}
      <button class="catalog-filter" type="button" data-filter="{{ filter.value }}" aria-pressed="false">{{ filter.label }}</button>
      {% endfor %}
    </div>
  </div>
  <div class="artwork-grid">
    {% for raw in clothingItems %}
    {% set item = raw | localize(locale) %}
    <article class="artwork-card" id="{{ item.slug }}" data-category="{{ item.category }}">
      <a class="artwork-tile" href="{{ locale | localePrefix }}/shop/{{ item.slug }}/" aria-label="{{ ('View product ' ~ item.name) if locale == 'en' else ('כניסה למוצר ' ~ item.name) }}">
        <span class="artwork-tile-image"><img src="{{ item.thumb }}?v={{ buildTime }}" alt="{{ item.alt }}" loading="lazy"></span>
        <span class="artwork-tile-caption">
          <strong>{{ item.name | bidiName | safe }}</strong>
          {% set lowPrice = item.purchaseVariants | lowestPrice %}
          {% if lowPrice %}<span class="artwork-tile-price">{{ "From " if locale == "en" else "החל מ- " }}<span>{{ lowPrice }} ₪</span></span>{% endif %}
        </span>
      </a>
    </article>
    {% endfor %}
    {% if not clothingItems.length %}
    <p class="catalog-empty">{{ "New items coming soon." if locale == "en" else "בקרוב - פריטים חדשים בדרך." }}</p>
    {% endif %}
  </div>
</section>
