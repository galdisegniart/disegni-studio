---
layout: base.njk
activeNav: "חנות"
permalink: "/collections/apparel/index.html"
scripts:
  - /js/catalog-filter.js
  - /js/mark-list.js
eleventyComputed:
  title: "{{ pages.apparel.title }}"
  description: "{{ pages.apparel.metaDescription }}"
---
{% set p = pages.apparel %}
{% set crumbs = [
  { label: "בית", href: "/" },
  { label: p.heading }
] %}
{% include "partials/breadcrumbs.njk" %}
<section class="gallery-intro-minimal">
  <div class="shop-intro-layout">
    <h1>{{ p.heading }}</h1>
    <div class="shop-intro-copy">
      <p>{{ p.heroText }}</p>
    </div>
  </div>
</section>

<section class="artwork-catalog gallery-catalog-compact section">
  <div class="catalog-toolbar">
    <div class="catalog-filters">
      <button class="catalog-filter active" type="button" data-filter="all" aria-pressed="true">{{ p.filterAllLabel }}</button>
      {% for filter in p.filters %}
      <button class="catalog-filter" type="button" data-filter="{{ filter.value }}" aria-pressed="false">{{ filter.label }}</button>
      {% endfor %}
    </div>
  </div>
  <div class="artwork-grid">
    {% for item in apparelItems %}
    <article class="artwork-card" id="{{ item.slug }}" data-category="{{ item.category }}">
      <a class="artwork-tile" href="/shop/{{ item.slug }}/" aria-label="כניסה למוצר {{ item.name }}">
        <span class="artwork-tile-image"><img src="{{ item.thumb }}" alt="{{ item.alt }}" loading="lazy"></span>
        <span class="artwork-tile-caption"><strong lang="en">{{ item.name }}</strong></span>
      </a>
    </article>
    {% endfor %}
    {% if not apparelItems.length %}
    <p class="catalog-empty">בקרוב - פריטים חדשים בדרך.</p>
    {% endif %}
  </div>
</section>
