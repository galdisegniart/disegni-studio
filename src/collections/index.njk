---
pagination:
  data: locales
  size: 1
  alias: locale
layout: base.njk
activeNav: "חנות"
permalink: "{{ locale | localePrefix }}/collections/index.html"
eleventyComputed:
  title: "{{ (pages.shopIndex | localize(locale)).title }}"
  description: "{{ (pages.shopIndex | localize(locale)).metaDescription }}"
---
{% set p = pages.shopIndex | localize(locale) %}
{% set shopCategories = locale | shopCategoriesFor %}
{% set crumbs = [
  { label: "Home" if locale == "en" else "בית", href: (locale | localePrefix) + "/" },
  { label: p.heading }
] %}
{% include "partials/breadcrumbs.njk" %}
<section class="gallery-intro-minimal">
  <div class="shop-intro-layout">
    <h1>{{ p.heading }}</h1>
    <div class="shop-intro-copy">
      <p>{{ p.heroText }}</p>
    </div>
  </div>
</section>

<section class="category-gallery" aria-label="{{ 'Shop categories' if locale == 'en' else 'קטגוריות בחנות' }}">
  {% for cat in shopCategories %}
  {% if cat.thumb %}
  <a class="category-gallery-card" href="{{ cat.href }}">
    <span class="category-gallery-thumb">
      <img src="{{ cat.thumb }}" alt="" loading="lazy">
    </span>
    <span class="category-gallery-label">{{ cat.label }}</span>
  </a>
  {% endif %}
  {% endfor %}
</section>
