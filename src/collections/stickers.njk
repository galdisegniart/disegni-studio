---
layout: base.njk
activeNav: "חנות"
activeCategory: "stickers"
permalink: "/collections/stickers/index.html"
scripts:
  - /js/mark-list.js
eleventyComputed:
  title: "{{ pages.stickers.title }}"
  description: "{{ pages.stickers.metaDescription }}"
---
{% include "partials/category-strip.njk" %}
{% set p = pages.stickers %}
{% set stickerItems = apparelItems | withCategory("stickers") %}
{% set crumbs = [
  { label: "בית", href: "/" },
  { label: p.heading }
] %}
{% include "partials/breadcrumbs.njk" %}
<section class="gallery-intro-minimal">
  <div class="shop-intro-layout">
    <h1>{{ p.heading }}</h1>
    <div class="shop-intro-copy">
      <p>{{ p.heroText }}</p>
    </div>
  </div>
</section>

<section class="artwork-catalog gallery-catalog-compact section">
  <div class="artwork-grid">
    {% for item in stickerItems %}
    <article class="artwork-card" id="{{ item.slug }}" data-category="{{ item.category }}">
      <a class="artwork-tile" href="/shop/{{ item.slug }}/" aria-label="כניסה למוצר {{ item.name }}">
        <span class="artwork-tile-image"><img src="{{ item.thumb }}?v={{ buildTime }}" alt="{{ item.alt }}" loading="lazy"></span>
        <span class="artwork-tile-caption"><strong>{{ item.name | bidiName | safe }}</strong></span>
      </a>
    </article>
    {% endfor %}
    {% if not stickerItems.length %}
    <p class="catalog-empty">בקרוב - פריטים חדשים בדרך.</p>
    {% endif %}
  </div>
</section>
