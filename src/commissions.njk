---
pagination:
  data: locales
  size: 1
  alias: locale
layout: base.njk
scripts:
  - /js/lead-form.js
  - /js/intro-video.js
permalink: "{{ locale | localePrefix }}/commissions/index.html"
eleventyComputed:
  title: "{{ (pages.commissions | localize(locale)).title }}"
  description: "{{ (pages.commissions | localize(locale)).metaDescription }}"
  ogImage: "{{ (pages.commissions | localize(locale)).heroImage }}"
  activeNav: "{{ 'Commissions' if locale == 'en' else 'יצירות בהזמנה' }}"
---
{% set p = pages.commissions | localize(locale) %}
{% if p.heroVisible != false %}
<section class="inner-hero commission-hero">
  <div class="inner-hero-copy">
    <p class="hero-eyebrow">{{ p.heroEyebrow }}</p>
    <h1>{{ p.heroHeading | safe }}</h1>
    <p>{{ p.heroLead }}</p>
    <div class="commission-hero-ctas">
      <a class="cta" href="#inquiry-form">{{ p.heroPrimaryCtaLabel }}</a>
      <a class="cta cta-outline" href="#options">{{ p.heroSecondaryCtaLabel }}</a>
    </div>
  </div>
  <figure class="inner-hero-art commission-feature-art">
    <img src="{{ p.heroImage }}" alt="{{ p.heroImageAlt }}">
    {% if p.heroImageCaption %}<figcaption>{{ p.heroImageCaption }}</figcaption>{% endif %}
  </figure>
</section>
{% endif %}

{% if p.introVideoVisible != false and (p.introVideoFile or p.introVideoUrl or p.introVideoPoster) %}
<section class="intro-video section">
  <div class="intro-video-copy">
    <div class="section-label"><span>{{ p.introVideoLabel }}</span></div>
    <h2>{{ p.introVideoHeading }}</h2>
    <p>{{ p.introVideoText }}</p>
  </div>
  <div class="intro-video-media js-intro-video"
    {% if p.introVideoFile %}data-video-file="{{ p.introVideoFile }}"{% endif %}
    {% if p.introVideoUrl %}data-video-url="{{ p.introVideoUrl }}"{% endif %}>
    {% if p.introVideoPoster %}
    <img class="intro-video-poster" src="{{ p.introVideoPoster }}" alt="{{ p.introVideoPosterAlt }}">
    {% endif %}
    <button type="button" class="intro-video-play js-intro-video-play" aria-label="הפעלת הסרטון">
      <span aria-hidden="true">▶</span>
    </button>
  </div>
</section>
{% endif %}

{% if p.worksVisible != false %}
<section class="works section" id="options">
  <div class="section-label"><span>{{ p.worksLabel }}</span></div>
  <div class="works-title">
    <h2>{{ p.worksHeading | safe }}</h2>
    <p>{{ p.worksLead }}</p>
  </div>
  <div class="works-list">
    {% for work in p.works %}
    {% if work.visible != false %}
    <article class="work-card{% if work.recommended %} work-card-recommended{% endif %}">
      {% if work.recommended %}<span class="work-card-badge">{{ p.recommendedLabel }}</span>{% endif %}
      {% if work.image %}
      <div class="work-card-image">
        <img src="{{ work.image }}" alt="{{ work.imageAlt or work.title }}" loading="lazy">
      </div>
      {% endif %}
      <div class="work-card-body">
        <h3>{{ work.title }}</h3>
        {% if work.personaLine %}<p class="work-card-persona">{{ work.personaLine }}</p>{% endif %}
        <p class="work-card-intro">{{ work.intro }}</p>
        {% if work.includes and work.includes.length %}
        <div class="work-card-includes">
          {% if work.includesLabel %}<span>{{ work.includesLabel }}</span>{% endif %}
          <ul>
            {% for item in work.includes %}
            <li>{{ item }}</li>
            {% endfor %}
          </ul>
        </div>
        {% endif %}
        <div class="work-card-meta">
          {% if work.timeEstimate %}<span class="work-card-meta-item"><strong>זמן יצירה:</strong> {{ work.timeEstimate }}</span>{% endif %}
          {% if work.spotsAvailable %}<span class="work-card-meta-item"><strong>מקומות פנויים:</strong> {{ work.spotsAvailable }}</span>{% endif %}
        </div>
        {% if work.paymentNote %}<p class="work-card-payment-note">{{ work.paymentNote }}</p>{% endif %}
      </div>
      <div class="work-card-footer">
        {% if work.price %}
        <p class="work-card-price">{% if work.priceFrom %}<span class="from">החל מ-</span>{% endif %}<strong>{{ work.price }}</strong><span>₪</span></p>
        {% endif %}
        <button type="button" class="cta js-path-select" data-path="{{ work.title }}">{{ work.pathCtaLabel or "לבחירת המסלול" }} <span aria-hidden="true">←</span></button>
      </div>
    </article>
    {% endif %}
    {% endfor %}
  </div>
</section>
{% endif %}

{% if p.processVisible != false %}
<section class="process section">
  <div class="section-label"><span>{{ p.processLabel }}</span></div>
  <div class="process-title">
    <h2>{{ p.processHeading }}</h2>
    <p>{{ p.processLead }}</p>
  </div>
  <ol class="steps">
    {% for step in p.steps %}
    {% if step.visible != false %}
    <li>
      <span class="step-number">{{ loop.index }}</span>
      {% if step.icon %}<img class="step-icon" src="{{ step.icon }}" alt="" loading="lazy">{% endif %}
      <h3>{{ step.title }}</h3>
      <p>{{ step.text }}</p>
    </li>
    {% endif %}
    {% endfor %}
  </ol>
</section>
{% endif %}

{% if p.caseStudiesVisible != false and p.caseStudies and p.caseStudies.length %}
<section class="case-studies section">
  <div class="section-label"><span>{{ p.caseStudiesLabel }}</span></div>
  <div class="process-title">
    <h2>{{ p.caseStudiesHeading }}</h2>
    <p>{{ p.caseStudiesLead }}</p>
  </div>
  <div class="case-studies-list">
    {% for cs in p.caseStudies %}
    {% if cs.visible != false %}
    <article class="case-study">
      {% if cs.image %}
      <figure class="case-study-image">
        <img src="{{ cs.image }}" alt="{{ cs.imageAlt or cs.displayName }}" loading="lazy">
      </figure>
      {% endif %}
      <div class="case-study-body">
        {% if cs.pathLabel %}<span class="case-study-path">{{ cs.pathLabel }}</span>{% endif %}
        {% if cs.showName != false and cs.displayName %}<h3>{{ cs.displayName }}</h3>{% endif %}
        {% if cs.story %}<p class="case-study-story">{{ cs.story }}</p>{% endif %}
        {% if cs.testimonialText %}<p class="case-study-testimonial">&ldquo;{{ cs.testimonialText }}&rdquo;</p>{% endif %}
        {% if cs.testimonialVideo %}
        <script type="application/ld+json">
        {
          "@context": "https://schema.org",
          "@type": "VideoObject",
          "name": {{ (cs.displayName or p.title) | dump | safe }},
          "description": {{ (cs.testimonialText or cs.story or p.title) | dump | safe }},
          "thumbnailUrl": "{{ site.siteUrl }}{{ cs.testimonialVideoPoster or cs.image }}",
          "contentUrl": "{{ site.siteUrl }}{{ cs.testimonialVideo }}",
          "uploadDate": "{{ buildDate }}"
        }
        </script>
        <video class="case-study-video" controls playsinline{% if cs.testimonialVideoPoster %} poster="{{ cs.testimonialVideoPoster }}"{% endif %}>
          <source src="{{ cs.testimonialVideo }}" type="video/mp4">
        </video>
        {% endif %}
        {% if cs.duration %}<span class="case-study-duration">משך היצירה: {{ cs.duration }}</span>{% endif %}
      </div>
    </article>
    {% endif %}
    {% endfor %}
  </div>
</section>
{% endif %}

{% if p.notesVisible != false %}
<section class="notes section">
  <div class="section-label"><span>{{ p.notesLabel }}</span></div>
  <h2>{{ p.notesHeading }}</h2>
  <ul class="notes-list">
    {% for note in p.notes %}
    <li>{{ note }}</li>
    {% endfor %}
  </ul>
</section>
{% endif %}

{% if p.faqVisible != false %}
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [{% for item in p.faq %}{% if item.visible != false %}{
    "@type": "Question",
    "name": {{ item.q | dump | safe }},
    "acceptedAnswer": {
      "@type": "Answer",
      "text": {{ item.a | dump | safe }}
    }
  }{% if not loop.last %},{% endif %}{% endif %}{% endfor %}]
}
</script>
<section class="faq section">
  <div class="faq-list">
    <div class="section-label"><span>{{ p.faqLabel }}</span></div>
    <h3>{{ p.faqHeading }}</h3>
    {% for item in p.faq %}
    {% if item.visible != false %}
    <details class="faq-item">
      <summary>{{ item.q }}</summary>
      <p>{{ item.a }}</p>
    </details>
    {% endif %}
    {% endfor %}
  </div>
</section>
{% endif %}

{% if p.exclusiveVisible != false %}
<section class="exclusive-commission section">
  <div class="section-label"><span>{{ p.exclusiveLabel }}</span></div>
  <h2>{{ p.exclusiveHeading }}</h2>
  <div class="exclusive-copy">
    {% for para in p.exclusiveParagraphs %}
    <p>{{ para }}</p>
    {% endfor %}
  </div>
  <a class="cta js-whatsapp" href="{{ p.exclusiveWaMessage | waLink }}" target="_blank" rel="noopener noreferrer">{{ p.exclusiveCtaLabel }} <span>←</span></a>
</section>
{% endif %}

{% if p.inquiryVisible != false %}
<section class="inquiry section" id="inquiry-form">
  <div class="section-label"><span>{{ p.inquiryLabel }}</span></div>
  <div class="inquiry-intro">
    <h2>{{ p.inquiryHeading | safe }}</h2>
    <div>
      <p>{{ p.inquiryText }}</p>
      <p class="inquiry-note">{{ p.inquiryNote }}</p>
    </div>
  </div>
  <form class="lead-form" id="lead-form" novalidate>
    <label><span>{{ p.inquiryNameLabel }}</span>
      <input type="text" name="name" required autocomplete="name">
    </label>
    <label><span>{{ p.inquiryContactLabel }}</span>
      <input type="text" name="contact" required autocomplete="tel">
    </label>
    <label><span>{{ p.inquiryPathLabel }}</span>
      <select name="path" required>
        <option value="" selected disabled>בחרו אפשרות</option>
        {% for work in p.works %}
        {% if work.visible != false %}
        <option value="{{ work.title }}">{{ work.title }}</option>
        {% endif %}
        {% endfor %}
        <option value="עדיין לא בטוח/ה">עדיין לא בטוח/ה</option>
      </select>
    </label>
    <label><span>{{ p.inquiryPurposeLabel }}</span>
      <select name="purpose" required>
        <option value="" selected disabled>בחרו אפשרות</option>
        {% for option in p.inquiryPurposeOptions %}
        <option value="{{ option }}">{{ option }}</option>
        {% endfor %}
      </select>
    </label>
    <label class="lead-form-full"><span>{{ p.inquiryMessageLabel }}</span>
      <textarea name="message" rows="3"></textarea>
    </label>
    {% if p.inquiryBudgetOptions and p.inquiryBudgetOptions.length %}
    <label><span>{{ p.inquiryBudgetLabel }}</span>
      <select name="budget">
        <option value="" selected>לא רלוונטי</option>
        {% for option in p.inquiryBudgetOptions %}
        <option value="{{ option }}">{{ option }}</option>
        {% endfor %}
      </select>
    </label>
    {% endif %}
    <label class="lead-form-checkbox lead-form-full">
      <input type="checkbox" name="privacy" required>
      <span>{{ p.inquiryPrivacyLabel }} <a href="/privacy/" target="_blank" rel="noopener noreferrer">{{ p.inquiryPrivacyLinkLabel }}</a></span>
    </label>
    <button class="cta lead-submit" type="submit">{{ p.inquirySubmitLabel }} <span>←</span></button>
    <p class="lead-form-success js-lead-success" role="status" hidden>{{ p.inquirySuccessMessage }}</p>
  </form>
</section>
{% endif %}

<div class="commission-sticky-cta js-sticky-cta" hidden>
  <span class="commission-sticky-cta-path js-sticky-cta-path"></span>
  <a href="#inquiry-form" class="cta js-sticky-cta-link">{{ p.heroPrimaryCtaLabel }}</a>
</div>
