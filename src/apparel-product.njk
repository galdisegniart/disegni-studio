---
pagination:
  data: apparelPages
  size: 1
  alias: entry
  addAllPagesToCollections: true
permalink: "{{ entry.locale | localePrefix }}/shop/{{ entry.item.slug }}/index.html"
layout: base-bare.njk
scripts:
  - /js/back-link.js
  - /js/share.js
  - /js/product-gallery.js
eleventyComputed:
  title: "{{ entry.item.name }} | גל דִּיסֵנִי"
  description: "{{ entry.item.name }}, {{ entry.item.description }}"
  ogImage: "{{ entry.item.image }}"
  locale: "{{ entry.locale }}"
  activeNav: "{{ 'Shop' if entry.locale == 'en' else 'חנות' }}"
---
{% set item = entry.item %}
{% set locale = entry.locale %}
{% set isEn = locale == "en" %}
{% set variants = item.purchaseVariants or [] %}
{% set lowestPrice = variants | lowestPrice %}

<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "Product",
  "name": {{ item.name | dump | safe }},
  "image": "{{ site.siteUrl }}{{ item.image }}",
  "description": {{ (item.name ~ ", " ~ item.description) | dump | safe }},
  "url": "{{ site.siteUrl }}{{ page.url }}",
  "brand": { "@id": "{{ site.siteUrl }}/#person" },
  "offers": {
    "@type": "AggregateOffer",
    "priceCurrency": "ILS",
    "lowPrice": "{{ lowestPrice or 0 }}",
    "availability": "https://schema.org/InStock",
    "url": "{{ site.siteUrl }}{{ page.url }}"
  }
}
</script>
<script>
  window.dataLayer = window.dataLayer || [];
  if (typeof gtag === "function") {
    gtag("event", "view_item", {
      currency: "ILS",
      value: {{ lowestPrice or 0 }},
      items: [{
        item_id: {{ item.slug | dump | safe }},
        item_name: {{ item.name | dump | safe }},
        price: {{ lowestPrice or 0 }}
      }]
    });
  }
</script>

{% set shopHref = "/collections/stickers/" if item.category == "stickers" else "/collections/apparel/" %}
{% if locale == "en" %}
{% set shopLabel = "Stickers" if item.category == "stickers" else "Apparel" %}
{% else %}
{% set shopLabel = "מדבקות" if item.category == "stickers" else "ביגוד" %}
{% endif %}
<section class="artwork-detail">
  {% set crumbs = [
    { label: "Home" if locale == "en" else "בית", href: (locale | localePrefix) + "/" },
    { label: shopLabel, href: shopHref },
    { label: item.name }
  ] %}
  {% include "partials/breadcrumbs.njk" %}
  <div class="artwork-utility">
    <a class="artwork-back js-back-link" href="{{ (locale | localePrefix) + shopHref }}"><span aria-hidden="true">→</span> <span class="js-back-label">{{ "Back to Shop" if isEn else "חזרה לחנות" }}</span></a>
  </div>
  <div class="artwork-detail-grid">
    <div class="artwork-gallery{% if not item.gallery or not item.gallery.length %} artwork-gallery-single{% endif %}">
      <div class="artwork-thumbnails" aria-label="{{ ('More images of ' ~ item.name) if isEn else ('תמונות נוספות של ' ~ item.name) }}"{% if not item.gallery or not item.gallery.length %} hidden{% endif %}>
        <button class="artwork-thumbnail is-active js-product-gallery-thumb" type="button" data-image="{{ item.image }}?v={{ buildTime }}" data-alt="{{ item.alt }}" data-zoom="false" data-product-type="{{ variants[0].productType }}" data-frame-color="{{ item.imageColor | colorSlug }}" aria-label="{{ 'View main image' if isEn else 'הצגת התמונה הראשית' }}" aria-current="true">
          <img src="{{ item.image }}?v={{ buildTime }}" alt="" loading="lazy">
        </button>
        {% for galleryImage in item.gallery %}
        <button class="artwork-thumbnail js-product-gallery-thumb" type="button" data-image="{{ galleryImage.image }}?v={{ buildTime }}" data-alt="{{ galleryImage.alt or item.alt }}" data-zoom="false" data-product-type="{{ variants[0].productType }}" data-frame-color="{{ galleryImage.color | colorSlug }}" aria-label="{{ ('View image ' ~ loop.index) if isEn else ('הצגת תמונה ' ~ loop.index) }}">
          <img src="{{ galleryImage.image }}?v={{ buildTime }}" alt="" loading="lazy">
        </button>
        {% endfor %}
      </div>
      <figure class="artwork-stage">
        <img class="js-product-gallery-main" src="{{ item.image }}?v={{ buildTime }}" alt="{{ item.alt }}" data-zoom-enabled="false">
        {% if item.gallery and item.gallery.length %}
        <button class="artwork-gallery-arrow artwork-gallery-arrow-prev js-product-gallery-prev" type="button" aria-label="{{ 'Previous image' if isEn else 'התמונה הקודמת' }}">
          <svg aria-hidden="true" viewBox="0 0 20 20" width="20" height="20"><path d="M13 5L8 10L13 15"></path></svg>
        </button>
        <button class="artwork-gallery-arrow artwork-gallery-arrow-next js-product-gallery-next" type="button" aria-label="{{ 'Next image' if isEn else 'התמונה הבאה' }}">
          <svg aria-hidden="true" viewBox="0 0 20 20" width="20" height="20"><path d="M8 5L13 10L8 15"></path></svg>
        </button>
        {% endif %}
      </figure>
    </div>

    <div class="artwork-detail-copy">
      <h1 class="product-title-label">{{ item.name | bidiName | safe }}</h1>
      <div class="print-order" data-artwork-slug="{{ item.slug }}" data-artwork-name="{{ item.name }}" data-artwork-image="{{ item.image }}" data-payment-image="{{ item.image }}">
        {% if lowestPrice %}
        <p class="print-order-startprice">{{ "Starting from" if isEn else "החל מ-" }} <span>{{ lowestPrice | numberFormat }} ₪</span></p>
        {% endif %}

        <div class="print-order-selects">
          <div class="print-order-field">
            <span class="print-order-field-label">{{ "Size" if isEn else "מידה" }}</span>
            <select class="js-size-select" aria-label="{{ 'Choose size' if isEn else 'בחירת מידה' }}">
              <option value="" selected>{{ "Choose a size" if isEn else "בחרו מידה" }}</option>
              {% for variant in variants %}
              {% set compositeSizeId = variant.sizeId + "-" + (variant.color | colorSlug) if variant.color else variant.sizeId %}
              <option
                value="{{ variant.productType }}:{{ compositeSizeId }}"
                data-product-type="{{ variant.productType }}"
                data-frame-color="{{ variant.color | colorSlug }}"
                data-size-id="{{ compositeSizeId }}"
                data-catalog-number="{{ variant.catalogNumber }}"
                data-price-ils="{{ variant.priceILS }}"
                data-price-usd="{{ variant.priceUSD }}"
                data-shipping-first-ils="{{ variant.shippingFirstILS }}"
                data-shipping-additional-ils="{{ variant.shippingAdditionalILS or 0 }}"
                data-shipping-first-usd="{{ variant.shippingFirstUSD }}"
                data-shipping-additional-usd="{{ variant.shippingAdditionalUSD or 0 }}"
                data-material-name="{{ item.name }}"
                data-label-cm="{{ variant.sizeId }}{% if variant.color %} · {{ variant.color }}{% endif %}"
                data-label-in="{{ variant.sizeId }}{% if variant.color %} · {{ variant.color }}{% endif %}"
              >{{ variant.productType | apparelTypeName(locale) }} · {{ variant.sizeId | bidiIsolatePlain }}{% if variant.color %} · {{ variant.color | bidiIsolatePlain }}{% endif %}</option>
              {% endfor %}
            </select>
          </div>
        </div>

        <div class="print-order-footrow">
          <p class="print-order-price">{{ "Total" if isEn else 'סה"כ' }} <span class="js-live-price">—</span></p>
          <div class="currency-toggle-mini">
            <button type="button" class="js-currency-toggle active" data-currency="ILS">₪</button>
            <span>·</span>
            <button type="button" class="js-currency-toggle" data-currency="USD">$</button>
          </div>
        </div>

        <div class="print-order-field print-order-qty-field">
          <span class="print-order-field-label">{{ "Quantity" if isEn else "כמות" }}</span>
          <div class="qty-stepper">
            <button type="button" class="js-order-qty-minus" aria-label="{{ 'Decrease quantity' if isEn else 'הפחתת כמות' }}">−</button>
            <span class="js-order-qty">1</span>
            <button type="button" class="js-order-qty-plus" aria-label="{{ 'Increase quantity' if isEn else 'הוספת כמות' }}">+</button>
          </div>
        </div>

        <button type="button" class="cta js-add-to-cart" disabled>{{ "Add to Cart" if isEn else "הוספה לעגלה" }}</button>

        <a class="cta cta-outline js-whatsapp" href="{{ (('Hi, I\'m interested in ' ~ item.name) if isEn else ('שלום, מתעניין/ת ב-' ~ item.name)) | waLink }}" target="_blank" rel="noopener noreferrer">{{ "Questions on WhatsApp" if isEn else "שאלות ב-WhatsApp" }} <span aria-hidden="true">←</span></a>

        <p class="print-order-note js-print-order-note"></p>
        <button class="artwork-share js-share" type="button" data-share-title="{{ item.name }} | {{ (site | localize(locale)).brand }}" data-share-text="{{ item.name }}, {{ item.description }}"><span aria-hidden="true">↗</span> <span class="js-share-label">{{ "Share" if isEn else "שיתוף" }}</span></button>

        <details class="print-order-details">
          <summary><span aria-hidden="true">☰</span> {{ "Details" if isEn else "פרטים" }}</summary>
          <div class="print-order-details-body">
            <p>{{ item.description | bidiWrap | safe }}</p>
            <p>{{ "Shipping is calculated by size and quantity." if isEn else "המשלוח מחושב לפי מידה וכמות." }}</p>
          </div>
        </details>
      </div>
    </div>
  </div>
</section>
