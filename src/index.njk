---
layout: base.njk
eleventyComputed:
  title: "{{ pages.home.title }}"
  description: "{{ pages.home.metaDescription }}"
activeNav: "גלריה"
permalink: "/index.html"
scripts:
  - /js/mark-list.js
---
{% set p = pages.home %}

<section class="artist-opening">
  <figure class="artist-opening-art">
    <img src="{{ p.heroImage }}" alt="{{ p.heroImageAlt }}">
  </figure>
  <div class="artist-opening-copy">
    <h1 id="hero-title">{{ p.headingLine1 }}<br><span>{{ p.headingLine2 | nl2br | safe }}</span></h1>
    <p class="artist-opening-lead">{{ p.leadText }}</p>
    <div class="opening-assurance">
      <p>{{ p.assuranceLine1 }}</p>
      <p>{{ p.assuranceLine2 }}</p>
    </div>
  </div>
</section>

<section class="home-journeys" aria-label="קטגוריות הגלריה">
  {% for category in pages.portfolio.categories %}
  {% if category.visible != false %}
  <a class="portfolio-category-band" href="/portfolio/{{ category.slug }}/">
    <img
      src="{{ category.image }}"
      alt="{{ category.alt }}"
      style="object-position: {{ category.imagePosition or 'center' }}"
      loading="lazy">
    <span class="portfolio-category-shade" aria-hidden="true"></span>
    <span class="portfolio-category-copy">
      <span class="portfolio-category-title">{{ category.title }}</span>
      <span class="portfolio-category-cta">{{ category.ctaLabel }}</span>
    </span>
  </a>
  {% endif %}
  {% endfor %}
</section>

<section class="home-gates" id="commercial" aria-label="{{ p.gatesAriaLabel }}">
  {% for gate in p.gates %}
  {% if gate.visible != false %}
  <a class="home-gate-card" href="{{ gate.href }}">
    <span class="home-gate-image">
      <img src="{{ gate.image }}" alt="{{ gate.alt or gate.label }}" style="object-position: {{ gate.imagePosition or 'center' }}" loading="lazy">
    </span>
    <span class="home-gate-copy">
      <strong>{{ gate.label }}</strong>
      <span class="home-gate-cta">{{ gate.ctaLabel }}</span>
    </span>
  </a>
  {% endif %}
  {% endfor %}
</section>

<section class="gallery section home-gallery">
  <header class="home-gallery-heading">
    <h2>{{ p.galleryHeading }}</h2>
  </header>
  <div class="gallery-editorial home-art-grid">
    {% for artwork in artworks %}
    <figure class="gallery-item">
      <a class="gallery-link" href="/products/{{ artwork.slug }}/">
        <span class="gallery-frame"><img src="{{ artwork.thumb }}" alt="{{ artwork.name }}" loading="lazy"></span>
        <figcaption><strong title="{{ artwork.name }}">{{ artwork.name }}</strong></figcaption>
      </a>
    </figure>
    {% endfor %}
  </div>
</section>
