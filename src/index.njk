---
layout: base.njk
eleventyComputed:
  title: "{{ pages.home.title }}"
  description: "{{ pages.home.metaDescription }}"
activeNav: "גלריה"
permalink: "/index.html"
scripts:
  - /js/mark-list.js
---
{% set p = pages.home %}
{% set printFrom = pages.pricing.materials | priceRange([]) %}
{% set commissionFrom = pages.commissions.works | minPrice("price") %}
{% set workshopFrom = workshops | minPrice("priceFromILS") %}
<section class="artist-opening">
  <figure class="artist-opening-art">
    <img src="{{ p.heroImage }}" alt="{{ p.heroImageAlt }}">
  </figure>
  <div class="artist-opening-copy">
    <h1 id="hero-title">{{ p.headingLine1 }}<br><span>{{ p.headingLine2 }}</span></h1>
    <p class="artist-opening-lead">{{ p.leadText }}</p>
    <div class="opening-assurance">
      <p>{{ p.assuranceLine1 }}</p>
      <p>{{ p.assuranceLine2 }}</p>
    </div>
  </div>
</section>

<section class="home-gates" aria-label="{{ p.gatesAriaLabel }}">
  <a class="home-gate-card" href="/collections/originals/">
    <span class="home-gate-image"><img src="{{ p.gates[0].image }}" alt="{{ p.gates[0].label }}" loading="lazy"></span>
    <span class="home-gate-copy">
      <strong>{{ p.gates[0].label }}</strong>
      <small>{{ p.gates[0].subtitle }}</small>
    </span>
  </a>
  <a class="home-gate-card" href="/collections/prints/">
    <span class="home-gate-image"><img src="{{ p.gates[1].image }}" alt="{{ p.gates[1].label }}" loading="lazy"></span>
    <span class="home-gate-copy">
      <strong>{{ p.gates[1].label }}</strong>
      <small>{{ p.gatesPricePrefix }}{{ printFrom.low | numberFormat }} ₪</small>
    </span>
  </a>
  <a class="home-gate-card" href="/commissions/">
    <span class="home-gate-image"><img src="{{ p.gates[2].image }}" alt="{{ p.gates[2].label }}" loading="lazy"></span>
    <span class="home-gate-copy">
      <strong>{{ p.gates[2].label }}</strong>
      <small>{{ p.gatesPricePrefix }}{{ commissionFrom | numberFormat }} ₪</small>
    </span>
  </a>
  <a class="home-gate-card" href="/workshops/">
    <span class="home-gate-image"><img src="{{ p.gates[3].image }}" alt="{{ p.gates[3].label }}" loading="lazy"></span>
    <span class="home-gate-copy">
      <strong>{{ p.gates[3].label }}</strong>
      <small>{{ p.gatesPricePrefix }}{{ workshopFrom | numberFormat }} ₪</small>
    </span>
  </a>
</section>

<section class="gallery section home-gallery">
  <div class="gallery-editorial home-art-grid">
    {% for artwork in artworks %}
    <figure class="gallery-item">
      <a class="gallery-link" href="/products/{{ artwork.slug }}/">
        <span class="gallery-frame"><img src="{{ artwork.thumb }}" alt="{{ artwork.name }}" loading="lazy"></span>
        <figcaption><strong title="{{ artwork.name }}">{{ artwork.name }}</strong></figcaption>
      </a>
    </figure>
    {% endfor %}
  </div>
</section>
