---
pagination:
  data: locales
  size: 1
  alias: locale
  addAllPagesToCollections: true
layout: base.njk
permalink: "{{ locale | localePrefix }}/contact/index.html"
eleventyComputed:
  title: "{{ (pages.contact | localize(locale)).title }}"
  description: "{{ (pages.contact | localize(locale)).metaDescription }}"
  activeNav: "{{ 'Contact' if locale == 'en' else 'יצירת קשר' }}"
---
{% set p = pages.contact | localize(locale) %}
{% set isEn = locale == "en" %}
<section class="about-artist-hero">
  <figure class="about-artist-portrait">
    <img src="{{ p.portrait }}" alt="{{ p.portraitAlt }}">
  </figure>
  <div class="about-artist-intro">
    <p class="hero-eyebrow">{{ p.heroEyebrow }}</p>
    <h1>{{ p.heroHeading | safe }}</h1>
    <p>{{ p.heroLead }}</p>
  </div>
</section>

<section class="contact-details section">
  <div class="section-label"><span>{{ p.emailsLabel }}</span></div>
  <ul class="contact-emails">
    {% for e in p.emails %}
    <li>
      <span>{{ e.label }}</span>
      <a href="mailto:{{ e.address }}" dir="ltr">{{ e.address }}</a>
    </li>
    {% endfor %}
  </ul>
  <a class="cta js-whatsapp" data-option="יצירת קשר" href="{{ p.waMessage | waLink }}" target="_blank" rel="noopener noreferrer">{{ p.waCtaLabel }} <span>←</span></a>

  <div class="legal-identity contact-business">
    <h2>{{ p.businessLabel }}</h2>
    <dl class="legal-identity-list">
      {% if site.businessLegalName %}<div><dt>{{ "Business Name" if isEn else "שם העוסק" }}</dt><dd>{{ site.businessLegalName }}</dd></div>{% endif %}
      {% if site.businessNumber %}<div><dt>{{ site.businessStatus }} {{ "No." if isEn else "מס'" }}</dt><dd dir="ltr">{{ site.businessNumber }}</dd></div>{% endif %}
      {% if site.businessAddress %}<div><dt>{{ "Address" if isEn else "כתובת" }}</dt><dd>{{ site.businessAddress }}, {{ site.businessCity }}</dd></div>{% endif %}
      <div><dt>{{ "Phone" if isEn else "טלפון" }}</dt><dd><a href="tel:{{ site.businessPhoneLink }}" dir="ltr">{{ site.businessPhone }}</a></dd></div>
      <div><dt>{{ "Response Time" if isEn else "זמן מענה" }}</dt><dd>{{ site.responseTimeLabel }}</dd></div>
    </dl>
  </div>
</section>

<section class="contact-social section">
  <div class="section-label"><span>{{ p.socialLabel }}</span></div>
  <h2>{{ p.socialHeading }}</h2>
  <div class="contact-social-links">
    <a class="cta cta-outline" href="{{ site.socials[0].href }}" target="_blank" rel="noopener noreferrer">{{ site.socials[0].name }} <span>↗</span></a>
    <a class="cta cta-outline" href="{{ site.socials[1].href }}" target="_blank" rel="noopener noreferrer">{{ site.socials[1].name }} <span>↗</span></a>
    <a class="cta cta-outline" href="{{ site.socials[2].href }}" target="_blank" rel="noopener noreferrer">{{ site.socials[2].name }} <span>↗</span></a>
  </div>
</section>

<section class="contact-legal">
  <p>{{ p.legalNote }}</p>
  <a href="/rights/">{{ p.legalCtaLabel }} <span aria-hidden="true">←</span></a>
</section>
