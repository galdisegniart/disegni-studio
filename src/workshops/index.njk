---
layout: base.njk
eleventyComputed:
  title: "{{ pages.workshopsIndex.title }}"
  description: "{{ pages.workshopsIndex.metaDescription }}"
activeNav: "סדנאות"
permalink: "/workshops/index.html"
scripts:
  - /js/reviews.js
---
{% set w = pages.workshopsIndex %}
<section class="workshop-visual-hero">
  <p class="hero-eyebrow">{{ w.heroEyebrow | replace('{brand}', site.brand) }}</p>
  <div class="workshop-visual-grid">
    {% for item in workshops %}
    <a class="workshop-visual-card" href="/workshops/{{ item.slug }}/" aria-label="ל{{ item.cardTitle }}">
      <figure><img src="{{ item.cardImage }}" alt="{{ item.cardImageAlt }}"></figure>
      <span><small>{{ item.cardLabel }}</small><strong>{{ item.cardTitle }}</strong><i aria-hidden="true">←</i></span>
    </a>
    {% endfor %}
  </div>
</section>

<section class="reviews-section reviews-centered section">
  <div class="reviews-heading">
    <p class="hero-eyebrow">{{ w.reviewsLabel }}</p>
    <h2>{{ w.reviewsHeading }}</h2>
    <div class="review-summary" aria-label="{{ w.reviewsRatingAriaLabel }}"><strong>{{ w.reviewsRatingValue }}</strong><span aria-hidden="true">★★★★★</span><small>{{ w.reviewsCountLabel }}</small></div>
  </div>

  <details class="review-card">
    <summary>
      <span class="review-card-top"><span><strong>{{ w.featuredReview.name }}</strong><time datetime="{{ w.featuredReview.date }}">{{ w.featuredReview.dateLabel }}</time></span><span class="review-stars" aria-label="{{ w.featuredReview.starsAriaLabel }}">★★★★★</span></span>
      <span class="review-excerpt">{{ w.featuredReview.excerpt }}</span>
      <span class="review-read-more">לקריאת חוות הדעת המלאה <b aria-hidden="true">＋</b></span>
    </summary>
    <blockquote>{{ w.featuredReview.fullText }}</blockquote>
  </details>
</section>

<section class="workshop-picker section">
  <div class="workshop-picker-heading">
    <div>
      <p class="hero-eyebrow">{{ w.pickerEyebrow }}</p>
      <h1>{{ w.pickerHeading | safe }}</h1>
    </div>
    <p>{{ w.pickerText }}</p>
  </div>
</section>

<section class="workshop-overview-contact section">
  <div class="workshop-overview-contact-copy">
    <p class="hero-eyebrow">{{ w.contactEyebrow }}</p>
    <h2>{{ w.contactHeading | safe }}</h2>
    <p>{{ w.contactText }}</p>
  </div>
  <a class="cta js-whatsapp" data-option="ייעוץ לבחירת סדנה" href="{{ w.contactWaMessage | waLink }}" target="_blank" rel="noopener noreferrer">{{ w.contactCtaLabel }} <span>←</span></a>
</section>
