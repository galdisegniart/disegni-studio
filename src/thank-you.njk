---
layout: base.njk
permalink: "/thank-you/index.html"
noindex: true
scripts:
  - /js/thank-you.js
eleventyComputed:
  title: "{{ pages.thankYou.title }}"
  description: "{{ pages.thankYou.metaDescription }}"
---
{% set p = pages.thankYou %}
<section class="thank-you section" data-thank-you
  data-heading-paid="{{ p.heading }}"
  data-lead-paid="{{ p.lead }}"
  data-heading-pending="{{ p.pendingHeading }}"
  data-lead-pending="{{ p.pendingLead }}"
  data-heading-failed="{{ p.failedHeading }}"
  data-lead-failed="{{ p.failedLead }}"
  data-heading-notfound="{{ p.notFoundHeading }}"
  data-lead-notfound="{{ p.notFoundLead }}">
  <div class="thank-you-inner">
    <div class="thank-you-mark" aria-hidden="true">
      <svg viewBox="0 0 32 32">
        <path d="m8 16.5 5 5L24 10"></path>
      </svg>
    </div>
    <h1 data-thank-you-heading>{{ p.checkingHeading }}</h1>
    <p class="thank-you-lead" data-thank-you-lead>{{ p.checkingLead }}</p>
    <p class="thank-you-note">{{ p.note }}</p>
    <div class="thank-you-actions">
      <a class="cta" href="{{ p.ctaHref }}">{{ p.ctaLabel }} <span>←</span></a>
      <a class="cta cta-outline" href="{{ p.contactCtaHref }}">{{ p.contactCtaLabel }} <span>←</span></a>
    </div>
  </div>
</section>
