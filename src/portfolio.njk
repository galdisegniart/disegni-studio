---
layout: base.njk
activeNav: "פורטפוליו"
permalink: "/portfolio/index.html"
eleventyComputed:
  title: "{{ pages.portfolio.title }}"
  description: "{{ pages.portfolio.metaDescription }}"
---
{% set p = pages.portfolio %}
{% set crumbs = [
  { label: "בית", href: "/" },
  { label: p.heroHeading }
] %}
{% include "partials/breadcrumbs.njk" %}

<header class="portfolio-gallery-heading">
  <h1>{{ p.heroHeading }}</h1>
</header>

<div class="portfolio-category-index">
  {% for category in p.categories %}
  {% if category.visible != false %}
  <a class="portfolio-category-band" href="/portfolio/{{ category.slug }}/">
    <img
      src="{{ category.image }}"
      alt="{{ category.alt }}"
      style="object-position: {{ category.imagePosition or 'center' }}"
      {% if not loop.first %}loading="lazy"{% endif %}>
    <span class="portfolio-category-shade" aria-hidden="true"></span>
    <span class="portfolio-category-copy">
      <span class="portfolio-category-title">{{ category.title }}</span>
      <span class="portfolio-category-cta">{{ category.ctaLabel }}</span>
    </span>
  </a>
  {% endif %}
  {% endfor %}
</div>
