---
layout: base-bare.njk
title: "אישור קבלות Bit | גל דִּיסֵנִי"
description: "עמוד אדמין פנימי - לא לשימוש לקוחות."
permalink: "/admin-bit-receipts/index.html"
noindex: true
noAnalytics: true
---
<section style="max-width: 720px; margin: 80px auto; padding: 0 24px; color: var(--bone); font-family: var(--sans);">
  <h1 style="font-size: 24px; margin-bottom: 8px;">אישור קבלות Bit</h1>
  <p style="color: var(--dim); margin-bottom: 32px;">
    בקשות שממתינות לאישור אחרי תשלום Bit. אפשר לתקן פרטים לפני שמפיקים
    בפועל קבלה אמיתית ב-SmartBee, או לדחות בקשה שגויה/כפולה בלי להפיק כלום.
  </p>

  <label style="display: flex; flex-direction: column; gap: 6px; margin-bottom: 24px;">
    <span>מפתח אדמין</span>
    <input type="password" id="admin-key" autocomplete="off"
      style="padding: 10px; background: transparent; border: 1px solid var(--line); color: var(--bone); max-width: 320px;" />
  </label>

  <button type="button" id="load-btn" style="padding: 10px 18px; background: transparent; border: 1px solid var(--copper); color: var(--copper); cursor: pointer; margin-bottom: 24px;">
    טען בקשות ממתינות
  </button>

  <p id="list-message" style="color: var(--dim); font-size: 14px;">הזינו מפתח אדמין ולחצו "טען בקשות ממתינות".</p>
  <div id="receipts-list"></div>

  <hr style="border-color: var(--line); margin: 40px 0;" />

  <h2 style="font-size: 18px; margin-bottom: 8px;">יצירת בקשה ידנית מצילום מסך</h2>
  <p style="color: var(--dim); margin-bottom: 16px; font-size: 14px;">
    שימושי כשמקבלים צילום מסך של תשלום Bit בוואטסאפ - מדביקים אותו ישירות
    כאן, בלי להוריד ולהעלות כקובץ. הפרטים ניתנים לעריכה לפני יצירת הבקשה,
    שתופיע ברשימת "בקשות ממתינות" למעלה לאישור רגיל.
  </p>
  <div id="manual-paste-target" tabindex="0" style="border: 1px dashed var(--copper); padding: 16px; margin-bottom: 8px; color: var(--copper); cursor: text;">
    לחצו כאן והדביקו תמונה (Ctrl+V)
  </div>
  <p style="color: var(--dim); font-size: 13px; margin-bottom: 16px;">אפשר גם להדביק תמונה שהעתקת (Ctrl+V, או "הדבק" בלחיצה ארוכה בנייד).</p>
  <p id="manual-upload-message" style="font-size: 14px; margin-bottom: 16px;"></p>

  <div id="manual-entry-fields" hidden>
    <label style="display: flex; flex-direction: column; gap: 4px; margin-bottom: 10px;">
      <span style="font-size: 13px; color: var(--dim);">שם מלא</span>
      <input type="text" id="manual-name" style="padding: 8px; background: transparent; border: 1px solid var(--line); color: var(--bone);" />
    </label>
    <label style="display: flex; flex-direction: column; gap: 4px; margin-bottom: 10px;">
      <span style="font-size: 13px; color: var(--dim);">טלפון</span>
      <input type="text" id="manual-phone" style="padding: 8px; background: transparent; border: 1px solid var(--line); color: var(--bone);" />
    </label>
    <label style="display: flex; flex-direction: column; gap: 4px; margin-bottom: 10px;">
      <span style="font-size: 13px; color: var(--dim);">דוא"ל</span>
      <input type="email" id="manual-email" style="padding: 8px; background: transparent; border: 1px solid var(--line); color: var(--bone);" />
    </label>
    <label style="display: flex; flex-direction: column; gap: 4px; margin-bottom: 10px;">
      <span style="font-size: 13px; color: var(--dim);">סכום (₪)</span>
      <input type="number" id="manual-amount" style="padding: 8px; background: transparent; border: 1px solid var(--line); color: var(--bone);" />
    </label>
    <label style="display: flex; flex-direction: column; gap: 4px; margin-bottom: 10px;">
      <span style="font-size: 13px; color: var(--dim);">תאריך תשלום (YYYY-MM-DD)</span>
      <input type="text" id="manual-date" style="padding: 8px; background: transparent; border: 1px solid var(--line); color: var(--bone);" />
    </label>
    <label style="display: flex; flex-direction: column; gap: 4px; margin-bottom: 10px;">
      <span style="font-size: 13px; color: var(--dim);">תיאור</span>
      <input type="text" id="manual-description" style="padding: 8px; background: transparent; border: 1px solid var(--line); color: var(--bone);" />
    </label>
    <label style="display: flex; flex-direction: column; gap: 4px; margin-bottom: 10px;">
      <span style="font-size: 13px; color: var(--dim);">אסמכתת Bit</span>
      <input type="text" id="manual-ref" style="padding: 8px; background: transparent; border: 1px solid var(--line); color: var(--bone);" />
    </label>
    <button type="button" id="manual-submit-btn" style="padding: 10px 18px; background: transparent; border: 1px solid var(--copper); color: var(--copper); cursor: pointer;">
      צור בקשה
    </button>
    <p id="manual-submit-message" style="margin-top: 10px; font-size: 14px;"></p>
  </div>

  <hr style="border-color: var(--line); margin: 40px 0;" />

  <h2 style="font-size: 18px; margin-bottom: 8px;">בדיקת סטטוס קבלה</h2>
  <p style="color: var(--dim); margin-bottom: 16px; font-size: 14px;">
    בדיקה בלבד מול SmartBee (לא יוצרת מסמך ולא מפעילה אישור) - שימושי אחרי
    שבקשה כבר אושרה ואינה מופיעה יותר ברשימת הבקשות הממתינות למעלה.
  </p>
  <label style="display: flex; flex-direction: column; gap: 6px; margin-bottom: 12px; max-width: 320px;">
    <span>מזהה בקשה (requestId)</span>
    <input type="text" id="check-status-request-id"
      style="padding: 10px; background: transparent; border: 1px solid var(--line); color: var(--bone);" />
  </label>
  <button type="button" id="check-status-btn" style="padding: 10px 18px; background: transparent; border: 1px solid var(--copper); color: var(--copper); cursor: pointer;">
    בדוק סטטוס
  </button>
  <p id="check-status-message" style="margin-top: 12px; font-size: 14px;"></p>
</section>

<script>
(function () {
  var WORKER_ORIGIN = "https://disegni-cms-oauth.galdisegniart.workers.dev";

  function adminKey() {
    return document.getElementById("admin-key").value.trim();
  }

  function formatReadableDate(value) {
    var date = new Date(value);
    if (isNaN(date.getTime())) return "";
    var day = String(date.getDate()).padStart(2, "0");
    var month = String(date.getMonth() + 1).padStart(2, "0");
    return day + "/" + month + "/" + date.getFullYear();
  }

  function extractReceiptNumber(linkToOriginal) {
    if (!linkToOriginal) return "";
    var match = /\/(\d+)_Original\.pdf/.exec(linkToOriginal);
    return match ? match[1] : "";
  }

  function fieldRow(labelText, id, value, type, hint) {
    return (
      '<label style="display: flex; flex-direction: column; gap: 4px; margin-bottom: 10px;">' +
      '<span style="font-size: 13px; color: var(--dim);">' + labelText + (hint ? ' (' + hint + ')' : '') + '</span>' +
      '<input type="' + (type || "text") + '" id="' + id + '" value="' + (value == null ? "" : String(value).replace(/"/g, "&quot;")) + '" ' +
      'style="padding: 8px; background: transparent; border: 1px solid var(--line); color: var(--bone);" />' +
      '</label>'
    );
  }

  function renderReceipt(receipt) {
    var wrap = document.createElement("div");
    wrap.className = "js-receipt-row";
    wrap.style.cssText = "border: 1px solid var(--line); padding: 20px; margin-bottom: 16px;";
    var prefix = receipt.requestId;

    wrap.innerHTML =
      '<p style="font-weight: 600; margin: 0 0 12px;">' + receipt.requestId + '</p>' +
      fieldRow("שם מלא", prefix + "-name", receipt.customerName) +
      fieldRow("טלפון", prefix + "-phone", receipt.phone) +
      fieldRow("דוא\"ל", prefix + "-email", receipt.email) +
      fieldRow("סכום (₪)", prefix + "-amount", receipt.amount, "number") +
      fieldRow("תאריך תשלום", prefix + "-date", receipt.paymentDate, "text", formatReadableDate(receipt.paymentDate)) +
      fieldRow("תיאור", prefix + "-description", receipt.description) +
      fieldRow("אסמכתת Bit", prefix + "-ref", receipt.bitReference) +
      '<div style="display: flex; gap: 10px; margin-top: 12px;">' +
      '<button type="button" class="js-approve" data-request-id="' + receipt.requestId + '" style="padding: 10px 18px; background: #5c8a5c; color: #fff; border: none; cursor: pointer;">אשר והפק קבלה</button>' +
      '<button type="button" class="js-reject" data-request-id="' + receipt.requestId + '" style="padding: 10px 18px; background: transparent; border: 1px solid #c0554d; color: #c0554d; cursor: pointer;">דחה</button>' +
      '</div>' +
      '<p class="js-row-message" style="margin-top: 10px; font-size: 14px;"></p>';

    return wrap;
  }

  function loadReceipts() {
    var key = adminKey();
    var listMessage = document.getElementById("list-message");
    var listEl = document.getElementById("receipts-list");
    if (!key) {
      listMessage.textContent = "הזינו מפתח אדמין קודם.";
      return;
    }

    listMessage.textContent = "טוען...";
    fetch(WORKER_ORIGIN + "/admin/bit-receipts", {
      headers: { "X-Disegni-Admin-Key": key },
    })
      .then(function (response) {
        return response.json().then(function (data) {
          return { ok: response.ok, data: data };
        });
      })
      .then(function (result) {
        if (!result.ok || !result.data.ok) {
          listMessage.style.color = "#c0554d";
          listMessage.textContent = "שגיאה: " + ((result.data && result.data.error) || "לא ידוע");
          listEl.innerHTML = "";
          return;
        }
        listMessage.style.color = "var(--dim)";
        listEl.innerHTML = "";
        if (!result.data.receipts.length) {
          listMessage.textContent = "אין בקשות ממתינות כרגע.";
          return;
        }
        listMessage.textContent = "";
        result.data.receipts.forEach(function (receipt) {
          listEl.appendChild(renderReceipt(receipt));
        });
      })
      .catch(function () {
        listMessage.style.color = "#c0554d";
        listMessage.textContent = "שגיאת רשת.";
      });
  }

  document.getElementById("load-btn").addEventListener("click", loadReceipts);

  document.getElementById("receipts-list").addEventListener("click", function (event) {
    var approveBtn = event.target.closest(".js-approve");
    var rejectBtn = event.target.closest(".js-reject");
    if (!approveBtn && !rejectBtn) return;

    var requestId = (approveBtn || rejectBtn).dataset.requestId;
    var row = (approveBtn || rejectBtn).closest(".js-receipt-row");
    var rowMessage = row.querySelector(".js-row-message");
    var key = adminKey();
    if (!key) {
      rowMessage.style.color = "#c0554d";
      rowMessage.textContent = "הזינו מפתח אדמין קודם.";
      return;
    }

    var path = approveBtn ? "/admin/bit-receipts/approve" : "/admin/bit-receipts/reject";
    var body = { requestId: requestId };
    if (approveBtn) {
      body.customerName = document.getElementById(requestId + "-name").value;
      body.phone = document.getElementById(requestId + "-phone").value;
      body.email = document.getElementById(requestId + "-email").value;
      body.amount = Number(document.getElementById(requestId + "-amount").value);
      body.paymentDate = document.getElementById(requestId + "-date").value;
      body.description = document.getElementById(requestId + "-description").value;
      body.bitReference = document.getElementById(requestId + "-ref").value;
    }

    rowMessage.style.color = "var(--dim)";
    rowMessage.textContent = "שולח...";

    fetch(WORKER_ORIGIN + path, {
      method: "POST",
      headers: { "Content-Type": "application/json", "X-Disegni-Admin-Key": key },
      body: JSON.stringify(body),
    })
      .then(function (response) {
        return response.json().then(function (data) {
          return { ok: response.ok, data: data };
        });
      })
      .then(function (result) {
        if (!result.ok || !result.data.ok) {
          rowMessage.style.color = "#c0554d";
          rowMessage.textContent = "שגיאה: " + ((result.data && result.data.error) || "לא ידוע");
          return;
        }
        rowMessage.style.color = "#5c8a5c";
        rowMessage.textContent = approveBtn
          ? "אושר - סטטוס: " + result.data.status
          : "הבקשה נדחתה.";
        setTimeout(loadReceipts, 1200);
      })
      .catch(function () {
        rowMessage.style.color = "#c0554d";
        rowMessage.textContent = "שגיאת רשת.";
      });
  });

  // Manual "create pending request from a pasted screenshot" flow - lets Gal
  // paste a Bit screenshot received on WhatsApp straight in, instead of
  // saving it as a file and using the public upload form. Extract-only; the
  // record is created via the same public /bit-receipts/submit endpoint the
  // on-site form uses, so it lands in the pending list above like any other.
  (function () {
    var pasteTarget = document.getElementById("manual-paste-target");
    var uploadMessage = document.getElementById("manual-upload-message");
    var fieldsWrap = document.getElementById("manual-entry-fields");
    var submitBtn = document.getElementById("manual-submit-btn");
    var submitMessage = document.getElementById("manual-submit-message");

    function readFileAsDataUrl(file) {
      return new Promise(function (resolve, reject) {
        var reader = new FileReader();
        reader.onload = function () {
          resolve(reader.result);
        };
        reader.onerror = function () {
          reject(reader.error);
        };
        reader.readAsDataURL(file);
      });
    }

    pasteTarget.addEventListener("paste", function (event) {
      var items = (event.clipboardData && event.clipboardData.items) || [];
      var imageItem = Array.prototype.find.call(items, function (item) {
        return item.kind === "file" && /^image\//.test(item.type);
      });
      if (!imageItem) return;
      event.preventDefault();
      var file = imageItem.getAsFile();
      if (!file) return;

      if (file.size > 5 * 1024 * 1024) {
        uploadMessage.style.color = "#c0554d";
        uploadMessage.textContent = "התמונה גדולה מדי (עד 5MB).";
        return;
      }

      uploadMessage.style.color = "var(--dim)";
      uploadMessage.textContent = "קורא את הפרטים...";
      submitMessage.textContent = "";

      readFileAsDataUrl(file)
        .then(function (dataUrl) {
          return fetch(WORKER_ORIGIN + "/bit-receipts/extract", {
            method: "POST",
            headers: { "Content-Type": "application/json" },
            body: JSON.stringify({ image: dataUrl }),
          });
        })
        .then(function (response) {
          return response.json().then(function (data) {
            return { ok: response.ok, status: response.status, data: data };
          });
        })
        .then(function (result) {
          if (!result.ok) {
            uploadMessage.style.color = "#c0554d";
            uploadMessage.textContent =
              result.status === 429
                ? "נשלחו יותר מדי בקשות. נסו שוב בעוד כמה דקות."
                : "לא הצלחנו לקרוא את התמונה. אפשר למלא ידנית למטה.";
            fieldsWrap.hidden = false;
            return;
          }

          var extracted = (result.data && result.data.extracted) || {};
          var confidence = result.data && result.data.confidence;

          document.getElementById("manual-name").value = extracted.customerName || "";
          document.getElementById("manual-phone").value = extracted.phone || "";
          document.getElementById("manual-email").value = extracted.email || "";
          document.getElementById("manual-amount").value = extracted.amount != null ? extracted.amount : "";
          document.getElementById("manual-date").value = extracted.paymentDate || "";
          document.getElementById("manual-description").value = extracted.description || "";
          document.getElementById("manual-ref").value = extracted.bitReference || "";
          fieldsWrap.hidden = false;

          uploadMessage.style.color = confidence === "full" ? "#5c8a5c" : "var(--dim)";
          uploadMessage.textContent =
            confidence === "full"
              ? "הפרטים זוהו - כדאי לבדוק לפני יצירת הבקשה."
              : "לא הצלחנו לזהות הכל - השלימו/תקנו למטה לפני יצירת הבקשה.";
        })
        .catch(function () {
          uploadMessage.style.color = "#c0554d";
          uploadMessage.textContent = "אירעה שגיאה בקריאת התמונה. אפשר למלא ידנית למטה.";
          fieldsWrap.hidden = false;
        });
    });

    submitBtn.addEventListener("click", function () {
      var amountValue = Number(document.getElementById("manual-amount").value);
      var payload = {
        customerName: document.getElementById("manual-name").value.trim(),
        phone: document.getElementById("manual-phone").value.trim(),
        email: document.getElementById("manual-email").value.trim(),
        amount: amountValue,
        paymentDate: document.getElementById("manual-date").value.trim(),
        description: document.getElementById("manual-description").value.trim(),
        bitReference: document.getElementById("manual-ref").value.trim(),
      };

      submitMessage.style.color = "var(--dim)";
      submitMessage.textContent = "יוצר בקשה...";
      submitBtn.disabled = true;

      fetch(WORKER_ORIGIN + "/bit-receipts/submit", {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify(payload),
      })
        .then(function (response) {
          return response.json().then(function (data) {
            return { ok: response.ok, status: response.status, data: data };
          });
        })
        .then(function (result) {
          if (!result.ok) {
            submitMessage.style.color = "#c0554d";
            submitMessage.textContent =
              result.data && result.data.code === "duplicate_bit_reference"
                ? "האסמכתה הזו כבר קיימת."
                : "שגיאה: " + ((result.data && (result.data.error || (result.data.fields || []).join(", "))) || "לא ידוע");
            return;
          }
          submitMessage.style.color = "#5c8a5c";
          submitMessage.textContent = "הבקשה נוצרה - מופיעה ברשימה למעלה.";
          fieldsWrap.hidden = true;
          uploadMessage.textContent = "";
          loadReceipts();
        })
        .catch(function () {
          submitMessage.style.color = "#c0554d";
          submitMessage.textContent = "שגיאת רשת.";
        })
        .finally(function () {
          submitBtn.disabled = false;
        });
    });
  })();

  document.getElementById("check-status-btn").addEventListener("click", function () {
    var key = adminKey();
    var requestId = document.getElementById("check-status-request-id").value.trim();
    var msg = document.getElementById("check-status-message");

    if (!key) {
      msg.style.color = "#c0554d";
      msg.textContent = "הזינו מפתח אדמין קודם.";
      return;
    }
    if (!requestId) {
      msg.style.color = "#c0554d";
      msg.textContent = "הזינו מזהה בקשה (requestId).";
      return;
    }

    msg.style.color = "var(--dim)";
    msg.textContent = "בודק...";

    fetch(WORKER_ORIGIN + "/admin/bit-receipts/check-status", {
      method: "POST",
      headers: { "Content-Type": "application/json", "X-Disegni-Admin-Key": key },
      body: JSON.stringify({ requestId: requestId }),
    })
      .then(function (response) {
        return response.json().then(function (data) {
          return { ok: response.ok, data: data };
        });
      })
      .then(function (result) {
        if (!result.ok || !result.data.ok) {
          msg.style.color = "#c0554d";
          msg.textContent = "שגיאה: " + ((result.data && result.data.error) || "לא ידוע");
          return;
        }
        var data = result.data;
        var text = "סטטוס: " + data.status;
        if (data.status === "issued") {
          msg.style.color = "#5c8a5c";
          var readableNumber = extractReceiptNumber(data.linkToOriginal);
          if (readableNumber) {
            text += " | מספר קבלה: " + readableNumber;
          }
          text += " | מזהה פנימי: " + (data.documentId || "-");
          msg.innerHTML = "";
          msg.appendChild(document.createTextNode(text));
          if (data.linkToOriginal) {
            msg.appendChild(document.createTextNode(" | "));
            var link = document.createElement("a");
            link.href = data.linkToOriginal;
            link.target = "_blank";
            link.rel = "noopener noreferrer";
            link.textContent = "קישור ל-PDF";
            link.style.color = "var(--copper)";
            msg.appendChild(link);
          }
        } else {
          msg.style.color = "var(--dim)";
          msg.textContent = text;
        }
      })
      .catch(function () {
        msg.style.color = "#c0554d";
        msg.textContent = "שגיאת רשת.";
      });
  });
})();
</script>
