---
pagination:
  data: locales
  size: 1
  alias: locale
  addAllPagesToCollections: true
layout: base.njk
permalink: "{{ locale | localePrefix }}/accessibility/index.html"
eleventyComputed:
  title: "{{ (pages.accessibility | localize(locale)).title }}"
  description: "{{ (pages.accessibility | localize(locale)).metaDescription }}"
---
{% set p = pages.accessibility | localize(locale) %}
{% set isEn = locale == "en" %}
<section class="rights-hero">
  <div class="rights-hero-copy">
    <p class="hero-eyebrow">{{ p.heroEyebrow }}</p>
    <h1>{{ p.heroHeading | safe }}</h1>
    <p>{{ p.heroLead }}</p>
    {% if p.updatedLabel %}<p class="rights-updated">{{ p.updatedLabel }}</p>{% endif %}
  </div>
  <div class="rights-mark">♿</div>
</section>

<section class="rights-policy section">
  <div class="legal-identity">
    <h2>{{ p.identityHeading }}</h2>
    <dl class="legal-identity-list">
      {% if p.coordinatorName %}<div><dt>{{ "Accessibility Coordinator" if isEn else "רכז נגישות" }}</dt><dd>{{ p.coordinatorName }}</dd></div>{% endif %}
      <div><dt>{{ "Phone" if isEn else "טלפון" }}</dt><dd><a href="tel:{{ p.coordinatorPhone or site.businessPhoneLink }}" dir="ltr">{{ p.coordinatorPhoneLabel or site.businessPhone }}</a></dd></div>
      <div><dt>{{ "Email" if isEn else "דוא\"ל" }}</dt><dd><a href="mailto:{{ p.coordinatorEmail or site.supportEmail }}" dir="ltr">{{ p.coordinatorEmail or site.supportEmail }}</a></dd></div>
      <div><dt>{{ "Response Time" if isEn else "זמן מענה" }}</dt><dd>{{ site.responseTimeLabel }}</dd></div>
      {% if p.lastAuditLabel %}<div><dt>{{ "Last Accessibility Review" if isEn else "בדיקת הנגישות האחרונה" }}</dt><dd>{{ p.lastAuditLabel }}</dd></div>{% endif %}
    </dl>
  </div>

  <div class="rights-policy-list">
    {% for item in p.sections %}
    <article>
      <div>
        <h2>{{ item.heading }}</h2>
        {% for para in item.paragraphs %}
        <p>{{ para }}</p>
        {% endfor %}
        {% if item.bullets %}
        <ul class="legal-bullets">
          {% for bullet in item.bullets %}
          <li>{{ bullet | safe }}</li>
          {% endfor %}
        </ul>
        {% endif %}
      </div>
    </article>
    {% endfor %}
  </div>
  <p class="rights-legal-note">{{ p.legalNote }}</p>
</section>
