---
pagination:
  data: artworks
  size: 1
  alias: artwork
permalink: "/products/{{ artwork.slug }}/index.html"
layout: base-bare.njk
activeNav: "הדפסים"
scripts:
  - /js/back-link.js
  - /js/share.js
  - /js/product-gallery.js
  - /js/artwork-zoom.js
eleventyComputed:
  title: "{{ artwork.name }} | גל דִּיסֵנִי"
  description: "{{ artwork.name }}, {{ artwork.description }}"
  ogImage: "{{ artwork.image }}"
---
{% set seq = artworks | artworkSequence(artwork) %}
{% set pricing = pages.pricing %}
{% set shipping = pages.shipping %}
{% set pay = pages.payment %}
{% set extraMaterials = artwork.extraMaterials or [] %}
{% set printfulOptions = printfulCatalog | printfulOptions(artwork, pricing, shipping) %}

{% if printfulOptions and printfulOptions.length %}
{% set range = printfulOptions | optionPriceRange %}
{% else %}
{% set range = pricing.materials | priceRange(extraMaterials) %}
{% endif %}

<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "Product",
  "name": {{ (artwork.name ~ " - הדפס אמנותי") | dump | safe }},
  "image": "{{ site.siteUrl }}{{ artwork.image }}",
  "description": {{ (artwork.name ~ ", " ~ artwork.description) | dump | safe }},
  "url": "{{ site.siteUrl }}{{ page.url }}",
  "brand": { "@id": "{{ site.siteUrl }}/#person" },
  "offers": {
    "@type": "AggregateOffer",
    "priceCurrency": "ILS",
    "lowPrice": "{{ range.low }}",
    "highPrice": "{{ range.high }}",
    "availability": "https://schema.org/InStock",
    "url": "{{ site.siteUrl }}{{ page.url }}"
  }
}
</script>

<section class="artwork-detail">
  {% set crumbs = [
    { label: "בית", href: "/" },
    { label: "הדפסים", href: "/collections/prints/" },
    { label: artwork.name }
  ] %}
  {% include "partials/breadcrumbs.njk" %}
  <div class="artwork-utility">
    <a class="artwork-back js-back-link" href="/"><span aria-hidden="true">→</span> <span class="js-back-label">חזרה לגלריה</span></a>
  </div>
  <div class="artwork-detail-grid">
  {% if artwork.gallery and artwork.gallery.length %}
  <div class="artwork-gallery">
    <div class="artwork-thumbnails" aria-label="תמונות נוספות של {{ artwork.name }}">
      <button class="artwork-thumbnail is-active js-product-gallery-thumb" type="button" data-image="{{ artwork.image }}" data-alt="{{ artwork.alt }}" data-zoom="true" aria-label="הצגת היצירה המקורית" aria-current="true">
        <img src="{{ artwork.image }}" alt="" loading="lazy">
      </button>
      {% for galleryImage in artwork.gallery %}
      <button class="artwork-thumbnail js-product-gallery-thumb" type="button" data-image="{{ galleryImage.image }}" data-alt="{{ galleryImage.alt or artwork.alt }}" data-zoom="false"{% if galleryImage.productType %} data-product-type="{{ galleryImage.productType }}"{% endif %}{% if galleryImage.sizeId %} data-size-id="{{ galleryImage.sizeId }}"{% endif %}{% if galleryImage.frameColor %} data-frame-color="{{ galleryImage.frameColor }}"{% endif %} aria-label="הצגת מוקאפ {{ loop.index }}">
        <img src="{{ galleryImage.thumb or galleryImage.image }}" alt="" loading="lazy">
      </button>
      {% endfor %}
    </div>
    <figure class="artwork-stage">
      <img class="js-product-gallery-main" src="{{ artwork.image }}" alt="{{ artwork.alt }}" data-zoom-enabled="true">
      <button class="artwork-gallery-arrow artwork-gallery-arrow-prev js-product-gallery-prev" type="button" aria-label="התמונה הקודמת">
        <svg aria-hidden="true" viewBox="0 0 20 20" width="20" height="20">
          <path d="M13 5L8 10L13 15"></path>
        </svg>
      </button>
      <button class="artwork-gallery-arrow artwork-gallery-arrow-next js-product-gallery-next" type="button" aria-label="התמונה הבאה">
        <svg aria-hidden="true" viewBox="0 0 20 20" width="20" height="20">
          <path d="M8 5L13 10L8 15"></path>
        </svg>
      </button>
    </figure>
  </div>
  {% else %}
  <figure class="artwork-stage">
    <img src="{{ artwork.image }}" alt="{{ artwork.alt }}">
  </figure>
  {% endif %}
  <div class="artwork-detail-copy">
    <p class="artwork-detail-medium">{{ artwork.detailMedium }}</p>
    <h1>{{ artwork.name }}</h1>
    <p class="artwork-detail-description">{{ artwork.description }}</p>
    {% if artwork.originalAvailable %}
    <a class="original-crosslink" href="#original-purchase">{{ purchaseButtons.originalLabel }} — {{ artwork.originalPrice | numberFormat }} ₪ <span aria-hidden="true">←</span></a>
    {% endif %}
    <div class="print-order" data-artwork-slug="{{ artwork.slug }}" data-artwork-name="{{ artwork.name }}" data-artwork-image="{{ artwork.image }}">
      <p class="print-order-kicker">{{ purchaseButtons.printLabel }}</p>

      <div class="print-order-quality">
        <p class="print-order-quality-label">איכות גבוהה</p>
        <h2 class="print-order-quality-heading">אפשרויות הדפסה</h2>
        <ul class="print-order-quality-list">
          {% for material in pricing.materials %}
          {% if material.id == "paper" or material.id in extraMaterials %}
          <li><span class="print-order-quality-icon" aria-hidden="true">◈</span><span><strong>{{ material.name }}</strong> — {{ material.description }}</span></li>
          {% endif %}
          {% endfor %}
        </ul>
      </div>

      <div class="print-order-head">
        <div class="currency-toggle-mini">
          <button type="button" class="js-currency-toggle active" data-currency="ILS">₪ · ס"מ</button>
          <span>·</span>
          <button type="button" class="js-currency-toggle" data-currency="USD">$ · inch</button>
        </div>
      </div>

      <p class="print-order-price">סה"כ <span class="js-live-price">—</span></p>

      <select class="js-size-data" hidden aria-hidden="true" tabindex="-1">
        {% for material in pricing.materials %}
        {% if material.id == "paper" or material.id in extraMaterials %}
        {% for size in material.sizes %}
        <option value="{{ material.id }}:{{ size.id }}" data-material="{{ material.id }}" data-material-name="{{ material.name }}" data-note="{{ material.note }}" data-size-id="{{ size.id }}" data-label-in="{{ size.labelIn }}" data-label-cm="{{ size.labelCm }}" data-price-ils="{{ size.priceILS }}" data-price-usd="{{ size.priceUSD }}"{% if not size.available %} disabled{% endif %}></option>
        {% endfor %}
        {% endif %}
        {% endfor %}
      </select>

      {% if printfulOptions and printfulOptions.length %}
      <script class="js-printful-options" type="application/json">{{ printfulOptions | dump | safe }}</script>
      {% endif %}

      <div class="print-order-selects{% if printfulOptions and printfulOptions.length %} is-printful-driven{% endif %}">
        {% if printfulOptions and printfulOptions.length %}
        <div class="print-order-field">
          <span class="print-order-field-label">סוג הדפס</span>
          <select class="js-style-select" aria-label="בחירת סוג הדפס">
            <option value="" selected>בחרו סוג הדפס</option>
          </select>
        </div>
        <div class="print-order-field">
          <span class="print-order-field-label">גודל</span>
          <select class="js-size-select" aria-label="בחירת גודל" disabled>
            <option value="" selected>בחרו גודל</option>
          </select>
        </div>
        {% else %}
        <div class="print-order-field">
          <span class="print-order-field-label">סגנון</span>
          <select class="js-style-select" aria-label="בחירת סגנון הדפסה">
            <option value="" selected>בחרו סגנון</option>
            {% for material in pricing.materials %}
            {% if material.id == "paper" or material.id in extraMaterials %}
            <option value="{{ material.id }}">{{ material.name }}</option>
            {% endif %}
            {% endfor %}
          </select>
        </div>
        <div class="print-order-field">
          <span class="print-order-field-label">גודל</span>
          <select class="js-size-select" aria-label="בחירת גודל" disabled>
            <option value="" selected>בחרו סגנון קודם</option>
          </select>
        </div>
        {% endif %}
      </div>

      <div class="print-order-field print-order-qty-field">
        <span class="print-order-field-label">כמות</span>
        <div class="qty-stepper">
          <button type="button" class="js-order-qty-minus" aria-label="הפחתת כמות">−</button>
          <span class="js-order-qty">1</span>
          <button type="button" class="js-order-qty-plus" aria-label="הוספת כמות">+</button>
        </div>
      </div>

      <button type="button" class="cta js-add-to-cart" disabled>{{ purchaseButtons.addToCartLabel }}</button>
      <a class="cta cta-outline js-whatsapp" href="{{ (purchaseButtons.whatsappQuestionMessage | replace('{name}', artwork.name)) | waLink }}" target="_blank" rel="noopener noreferrer">{{ purchaseButtons.whatsappQuestionLabel }}</a>

      <p class="print-order-note js-print-order-note"></p>
      <button class="artwork-share js-share" type="button" data-share-title="{{ artwork.name }} | {{ site.brand }}" data-share-text="{{ artwork.name }}, {{ artwork.description }}"><span aria-hidden="true">↗</span> <span class="js-share-label">שיתוף</span></button>

      <details class="print-order-details">
        <summary><span aria-hidden="true">☰</span> {{ purchaseButtons.detailsLabel }}</summary>
        <div class="print-order-details-body">
          <p>{{ purchaseButtons.detailsReproductionText | replace('{medium}', artwork.detailMedium) }}</p>
          {% if artwork.purchaseVariants and artwork.purchaseVariants.length %}
          <p>המשלוח מחושב בנפרד לפי סוג ההדפס, הגודל והכמות.</p>
          {% else %}
          <p>{{ pricing.materials[0].note }}</p>
          {% endif %}
        </div>
      </details>

      <details class="print-order-details">
        <summary><span aria-hidden="true">✦</span> {{ purchaseButtons.inspirationLabel }}</summary>
        <div class="print-order-details-body">
          <p>{{ artwork.description }}</p>
        </div>
      </details>

      <details class="print-order-details">
        <summary><span aria-hidden="true">⬡</span> {{ purchaseButtons.collectionLabel }}</summary>
        <div class="print-order-details-body">
          <p>{{ purchaseButtons.collectionText | replace('{galleryMedium}', artwork.galleryMedium) | replace('{brand}', site.brand) }}</p>
        </div>
      </details>

      <details class="print-order-details">
        <summary><span aria-hidden="true">©</span> {{ purchaseButtons.copyrightLabel }}</summary>
        <div class="print-order-details-body">
          <p>{{ purchaseButtons.copyrightText | replace('{brand}', site.brand) }} <a href="/rights/">{{ purchaseButtons.copyrightLinkLabel }}</a></p>
        </div>
      </details>
    </div>
  </div>
  </div>
</section>

{% if artwork.originalAvailable %}
<section class="artwork-purchase" id="original-purchase">
  <div class="section-label"><span>{{ pay.sectionLabel }}</span></div>
  <h2>{{ pages.printQuality.limitedEdition.heading }}</h2>
  <p class="artwork-purchase-lead">{{ pay.lead }}</p>
  <p class="artwork-purchase-original-note">לרכישת היצירה המקורית "{{ artwork.name }}" במחיר {{ artwork.originalPrice | numberFormat }} ₪, בצעו העברה בנקאית לפרטים שלהלן ואשרו ב-WhatsApp.</p>

  <form id="cart-customer-form" class="cart-customer">
    <h2 class="cart-customer-heading">פרטי משלוח ויצירת קשר</h2>
    <div class="cart-customer-field">
      <label for="customer-name">שם מלא *</label>
      <input type="text" id="customer-name" required autocomplete="name">
    </div>
    <div class="cart-customer-field">
      <label for="customer-phone">טלפון *</label>
      <input type="tel" id="customer-phone" required autocomplete="tel">
    </div>
    <div class="cart-customer-field">
      <label for="customer-email">דוא"ל (לא חובה)</label>
      <input type="email" id="customer-email" autocomplete="email">
    </div>
    <div class="cart-customer-field">
      <label for="customer-address">כתובת למשלוח *</label>
      <textarea id="customer-address" required autocomplete="street-address" rows="2"></textarea>
    </div>
  </form>

  <dl class="artwork-purchase-bank">
    <div><dt>בנק</dt><dd>{{ pay.bankName }} ({{ pay.bankCode }})</dd></div>
    <div><dt>סניף</dt><dd>{{ pay.branch }}</dd></div>
    <div><dt>מספר חשבון</dt><dd dir="ltr">{{ pay.accountNumber }}</dd></div>
    <div><dt>שם בעל החשבון</dt><dd>{{ pay.accountHolder }}</dd></div>
  </dl>
  <a class="cta js-original-whatsapp" href="#" target="_blank" rel="noopener noreferrer" data-artwork-slug="{{ artwork.slug }}" data-artwork-name="{{ artwork.name }}" data-price="{{ artwork.originalPrice }}" data-base-message="שלום גל, ביצעתי העברה בנקאית עבור היצירה המקורית &quot;{{ artwork.name }}&quot;. אשמח לתיאום המשלוח.">אישור העברה ב-WhatsApp <span>←</span></a>
  <p class="artwork-purchase-note">{{ pay.waNote }}</p>
</section>
{% endif %}

{% set availableTypes = printfulOptions | uniqueProductTypes %}
{% set hasStory = artwork.story and artwork.story.paragraphs and artwork.story.paragraphs.length %}
{% set hasTestimony = artwork.testimony and (artwork.testimony.text or (artwork.testimony.video and artwork.testimony.video.file)) %}

{% if availableTypes.length or hasStory or hasTestimony %}
<section class="print-quality section">
  {% if hasStory %}
  <div class="print-quality-block">
    {% if artwork.story.heading %}<h2>{{ artwork.story.heading }}</h2>{% endif %}
    {% for paragraph in artwork.story.paragraphs %}
    <p>{{ paragraph }}</p>
    {% endfor %}
  </div>
  {% endif %}

  {% for type in availableTypes %}
  {% set pq = pages.printQuality[type] %}
  {% if pq %}
  <div class="print-quality-block">
    <h2>{{ pq.heading }}</h2>
    <p>{{ pq.text }}</p>
    <ul>
      {% for feature in pq.features %}
      <li>{{ feature }}</li>
      {% endfor %}
    </ul>
    {% if pq.browseHref %}
    <a class="print-quality-browse" href="{{ pq.browseHref }}">{{ pq.browseLabel }} <span aria-hidden="true">←</span></a>
    {% endif %}
  </div>
  {% endif %}
  {% endfor %}

  {% if hasTestimony %}
  <div class="print-quality-block">
    {% if artwork.testimony.heading %}<h2>{{ artwork.testimony.heading }}</h2>{% endif %}
    {% if artwork.testimony.text %}<p>{{ artwork.testimony.text }}</p>{% endif %}
    {% if artwork.testimony.video and artwork.testimony.video.file %}
    <video class="print-quality-video" controls playsinline{% if artwork.testimony.video.poster %} poster="{{ artwork.testimony.video.poster }}"{% endif %}>
      <source src="{{ artwork.testimony.video.file }}" type="video/mp4">
    </video>
    {% if artwork.testimony.video.caption %}<p class="print-quality-video-caption">{{ artwork.testimony.video.caption }}</p>{% endif %}
    {% endif %}
  </div>
  {% endif %}

</section>
{% endif %}

<section class="artwork-more">
  <div class="artwork-more-head">
    <a class="js-back-link" href="/"><span aria-hidden="true">→</span> <span class="js-back-label">חזרה לגלריה</span></a>
    <div class="artwork-sequence">
      <a id="previous-artwork" href="/products/{{ seq.prev.slug }}/" aria-label="היצירה הקודמת, {{ seq.prev.name }}">הקודמת</a>
      <span>/</span>
      <a id="next-artwork" href="/products/{{ seq.next.slug }}/" aria-label="היצירה הבאה, {{ seq.next.name }}">הבאה</a>
    </div>
  </div>
  <div class="artwork-more-grid">
    {% for item in seq.more %}
    <a class="more-artwork-card" href="/products/{{ item.slug }}/">
      <span class="more-artwork-image"><img src="{{ item.thumb }}" alt="{{ item.name }}" loading="lazy"></span>
      <span class="more-artwork-caption"><strong lang="en">{{ item.name }}</strong><small>{{ item.galleryMedium }}</small><i aria-hidden="true">←</i></span>
    </a>
    {% endfor %}
  </div>
</section>
